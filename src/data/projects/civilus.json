           "html": "<ul><li><p>Adobe Creative Cloud (Illustrator / Photoshop)</p></li><li><p>Figma</p></li><li><p>Google Fonts</p></li><li><p>VS Code</p></li><li><p>React · HTML · CSS · JavaScript</p></li><li><p>GitHub (version control)</p></li><li><p>Netlify (build &amp; hosting)</p></li></ul>"
          },
