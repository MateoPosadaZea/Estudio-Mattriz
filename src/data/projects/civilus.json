          {
           "type": "html",
           "html": "<h5><strong>Services</strong></h5>",
           "keepLast": false,
           "classes": [
            "font_line_height_1-2"
           ],
           "style": {}
          },
          {
           "type": "list",
           "icon": "dot",
           "spacing": "default",
           "html": "<ul><li><p>Brand system</p></li><li><p>Guidelines</p></li><li><p>UI kit</p></li><li><p>Web design and front-end development</p></li><li><p>Netlify deployment and domain setup</p></li></ul>"
          },
          {
           "type": "divider",
           "height": "25px",
           "line": false,
           "lineStyle": {
            "height": "25px"
           },
           "classes": [],
           "dclasses": [
            "divider"
           ]
          },
          {
           "type": "html",
           "html": "<h5><strong>What We Do</strong></h5>",
           "keepLast": false,
           "classes": [
            "font_line_height_1-2"
           ],
           "style": {}
          },
          {
           "type": "list",
           "icon": "dot",
           "spacing": "15px",
           "html": "<ul><li><p><strong>Brand strategy &amp; key messaging:</strong> Defined Civilus as an accessible, online companion for structural calculations, with messaging focused on speed, reliability, and ease of use.</p></li><li><p><strong>Brand guidelines:</strong> Usage rules for logo, color, and imagery to keep the brand consistent across the website, decks, and social channels.</p></li><li><p><strong>Identity system:</strong> Logotype and icon for use on the site header, favicons, and social avatars.</p></li><li><p><strong>Color system:</strong> Technical yet approachable palette with strong contrast for UI, charts, and call-to-action states.</p></li><li><p><strong>Typography system:</strong> Google Fonts stack optimized for legibility in dense numerical interfaces and small UI labels.</p></li><li><p><strong>UI kit:</strong> Buttons, inputs, cards, tables, and layout components designed for reusability across new tools and pages.</p></li><li><p><strong>Website:</strong> Landing page, tools overview, and contact form designed and coded for a smooth path from explanation to calculation.</p></li></ul>"
          },
          {
           "type": "divider",
           "height": "25px",
           "line": false,
           "lineStyle": {
            "height": "25px"
           },
           "classes": [],
           "dclasses": [
            "divider"
           ]
          },
          {
           "type": "html",
           "html": "<h5><strong>Stack</strong></h5>",
           "keepLast": false,
           "classes": [
            "font_line_height_1-2"
           ],
           "style": {}
          },
          {
           "type": "list",
           "icon": "dot",
