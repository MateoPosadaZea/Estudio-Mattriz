       ]
      },
      {
       "type": "html",
       "html": "<p><b class=\"f-bold\">Lo que hicimos<br> </b></p>",
       "keepLast": true,
       "classes": [],
       "style": {}
      },
      {
       "type": "html",
       "html": "<ol><li>Investigar y conocer la historia detrás del lugar</li><li>Generar base de datos</li><li>Bocetar</li><li>Diseñar el logotipo</li><li>Adquirir hosting y dominio</li><li>Diseño UI/UX del sitio web</li><li>Creación del sitio web</li><li>Programación HTML y CSS</li><li>Configuración de correo electrónico</li><li>Pruebas de usuario</li><li>Optimización de SEO</li><li>Lanzamiento</li></ol>",
       "keepLast": true,
