---
// Modos de color: blanco (texto negro), rojo (fondo blanco, texto rojo) y oscuro (negro suave,
// texto blanco). En el header es el ícono de contraste, que despliega los tres en una columna al
// pasar el mouse (o al tocarlo, en pantallas táctiles y con teclado); en
// el menú móvil van a la vista, en fila. El modo se guarda (src/scripts/color-modes.ts) y se aplica
// antes de pintar (Base.astro).
import { langOf, ui } from '../i18n';

interface Props {
  class?: string;
  /** Siempre abierta (menú móvil), sin el botón que la despliega. */
  open?: boolean;
}

const { class: className, open = false } = Astro.props;
const t = ui(langOf(Astro.url));
const MODES = ['white', 'red', 'dark'] as const;
---

<div class:list={['modes', className, { 'is-open': open, 'modes--static': open }]} data-modes>
  {
    !open && (
      <button class="modes__toggle" type="button" aria-expanded="false" aria-label={t.colorModes} data-modes-toggle>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" />
        </svg>
      </button>
    )
  }
  <div class="modes__panel" role="group" aria-label={t.colorModes}>
    {
      MODES.map((m, i) => (
        <button class={`modes__option modes__option--${m}`} type="button" aria-pressed="false" aria-label={t.modeNames[i]} title={t.modeNames[i]} data-mode={m} />
      ))
    }
  </div>
</div>

<script>
  import '../scripts/color-modes';
</script>

<style>
  .modes {
    position: relative;
    display: flex;
    align-items: center;
  }

  .modes__toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: inherit;
    transition: background-color 0.3s;
  }

  .modes__toggle:hover,
  .modes.is-open .modes__toggle {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  /* Columna gris claro (el mismo gris del hover) con las tres muestras, debajo del ícono. */
  .modes__panel {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .modes:not(.modes--static) .modes__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    z-index: 2;
    flex-direction: column;
    gap: 2px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: #ebebeb;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -6px);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 1, 0.3, 1),
      visibility 0s 0.3s;
  }

  /* Puente invisible entre el ícono y la columna, para que el hover no se corte al bajar. */
  .modes:not(.modes--static) .modes__panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 10px;
  }

  @media (hover: hover) {
    .modes:not(.modes--static):hover .modes__panel {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition:
        opacity 0.3s ease,
        transform 0.45s cubic-bezier(0.2, 1, 0.3, 1);
    }

    .modes:not(.modes--static):hover .modes__toggle {
      background: color-mix(in srgb, currentColor 10%, transparent);
    }
  }

  .modes.is-open:not(.modes--static) .modes__panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 1, 0.3, 1);
  }

  /* Cada muestra se dibuja igual que el ícono de contraste: un círculo del tamaño del ícono, con su
     contorno y la mitad izquierda del color del texto del modo, la derecha del color del fondo. */
  .modes__option {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    transition: transform 0.3s;
  }

  .modes__option::before {
    content: '';
    width: 18px;
    height: 18px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.8px var(--o);
    background: linear-gradient(90deg, var(--a) 0 50%, var(--b) 50% 100%);
  }

  .modes__option:hover {
    transform: scale(1.12);
  }

  .modes__option--white { --a: #0d0d0d; --b: #ffffff; --o: #0d0d0d; }
  .modes__option--red { --a: #e52603; --b: #ffffff; --o: #e52603; }
  .modes__option--dark { --a: #ffffff; --b: #0d0d0d; --o: #0d0d0d; }

  /* En el menú móvil del modo oscuro los contornos negros van en blanco para que se vean. */
  :global(html:not([data-theme='light'])) .modes--static .modes__option--white,
  :global(html:not([data-theme='light'])) .modes--static .modes__option--dark { --o: #ffffff; }

  @media (prefers-reduced-motion: reduce) {
    .modes__panel {
      transition: none !important;
    }
  }
</style>
