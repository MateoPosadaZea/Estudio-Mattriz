---
// Modos de color: blanco (texto negro), rojo (fondo blanco, texto rojo) y oscuro (negro suave,
// texto blanco). En el header es el ícono de contraste, que despliega una píldora con los tres; en
// el menú móvil la píldora va a la vista. El modo se guarda (src/scripts/color-modes.ts) y se aplica
// antes de pintar (Base.astro).
import { langOf, ui } from '../i18n';

interface Props {
  class?: string;
  /** Siempre abierta (menú móvil), sin el botón que la despliega. */
  open?: boolean;
}

const { class: className, open = false } = Astro.props;
const t = ui(langOf(Astro.url));
const MODES = ['white', 'red', 'dark'] as const;
---

<div class:list={['modes', className, { 'is-open': open, 'modes--static': open }]} data-modes>
  {
    !open && (
      <button class="modes__toggle" type="button" aria-expanded="false" aria-label={t.colorModes} data-modes-toggle>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" />
        </svg>
      </button>
    )
  }
  <div class="modes__panel" role="group" aria-label={t.colorModes}>
    {
      MODES.map((m, i) => (
        <button class={`modes__option modes__option--${m}`} type="button" aria-pressed="false" aria-label={t.modeNames[i]} title={t.modeNames[i]} data-mode={m} />
      ))
    }
    <span class="modes__label" aria-hidden="true">{t.colorModes}</span>
  </div>
</div>

<script>
  import '../scripts/color-modes';
</script>

<style>
  .modes {
    position: relative;
    display: flex;
    align-items: center;
  }

  .modes__toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: inherit;
    transition: background-color 0.3s;
  }

  .modes__toggle:hover,
  .modes.is-open .modes__toggle {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  /* Píldora oscura con las tres muestras y el nombre, como en la referencia. */
  .modes__panel {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px 10px 12px;
    border-radius: var(--radius-pill);
    background: rgba(52, 52, 52, 0.96);
    color: #ffffff;
    white-space: nowrap;
  }

  .modes:not(.modes--static) .modes__panel {
    position: absolute;
    top: calc(100% + 14px);
    right: -8px;
    z-index: 2;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 1, 0.3, 1),
      visibility 0s 0.3s;
  }

  .modes.is-open:not(.modes--static) .modes__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 1, 0.3, 1);
  }

  /* Cada muestra: el color del texto arriba a la izquierda y el del fondo abajo a la derecha,
     partidos en diagonal, con un aro gris. */
  .modes__option {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px rgba(52, 52, 52, 1),
      0 0 0 3.5px rgba(255, 255, 255, 0.28);
    background: linear-gradient(135deg, var(--a) 0 50%, var(--b) 50% 100%);
    transition: box-shadow 0.3s, transform 0.3s;
  }

  .modes__option:hover {
    transform: scale(1.08);
  }

  .modes__option[aria-pressed='true'] {
    box-shadow:
      0 0 0 2px rgba(52, 52, 52, 1),
      0 0 0 3.5px #ffffff;
  }

  .modes__option--white { --a: #141414; --b: #ffffff; }
  .modes__option--red { --a: #e0553f; --b: #ffffff; }
  .modes__option--dark { --a: #ffffff; --b: #141414; }

  .modes__label {
    margin-left: 8px;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .modes__panel {
      transition: none !important;
    }
  }
</style>
