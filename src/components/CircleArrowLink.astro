---
// Botón "arrow-circle-animation" de Salient ("Go to live project").
// Vivo: píldora blanca 14px/500, padding 7px 21px; círculo negro de 35px con flecha blanca.
// Hover (0.55s cubic-bezier(.12,.75,.4,1)): la flecha sale hacia arriba a la derecha, entra otra
// desde abajo a la izquierda y el círculo se recorta al 45 %.
interface Props {
  href: string;
  external?: boolean;
}
const { href, external = false } = Astro.props;
const arrow = 'M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z';
---

<a class="circle-link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <span><slot /></span>
  <span class="circle-link__circle" aria-hidden="true">
    <svg class="circle-link__arrow" viewBox="0 0 24 24"><path d={arrow}></path></svg>
    <svg class="circle-link__arrow circle-link__arrow--in" viewBox="0 0 24 24"><path d={arrow}></path></svg>
  </span>
</a>

<style>
  .circle-link {
    --ease: cubic-bezier(0.12, 0.75, 0.4, 1);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 21px;
    border: 1px solid var(--color-white);
    border-radius: 200px;
    background: var(--color-white);
    color: var(--color-black);
    font-size: 14px;
    font-weight: 500;
    line-height: 26px;
  }

  .circle-link__circle {
    position: relative;
    width: 35px;
    aspect-ratio: 1;
    border-radius: 100%;
    overflow: hidden;
    background: var(--color-black);
    clip-path: circle(50% at 50% 50%);
    transition: clip-path 0.55s var(--ease);
  }

  .circle-link__arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 50%;
    height: 50%;
    fill: var(--color-white);
    transform: translate(-50%, -50%);
    transition: transform 0.55s var(--ease);
  }

  .circle-link__arrow--in {
    top: 100%;
    left: 0;
  }

  .circle-link:hover .circle-link__arrow {
    transform: translate(50%, -150%);
  }

  .circle-link:hover .circle-link__circle {
    clip-path: circle(45% at 50% 50%);
  }

  /* Vivo: en teléfono la píldora mide 67px (8px más de relleno arriba y abajo). */
  @media (max-width: 690px) {
    .circle-link {
      padding: 15px 21px;
    }
  }
</style>
