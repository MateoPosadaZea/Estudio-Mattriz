---
// v2: "One studio. Real systems." sigue el tema (negro en oscuro, claro en claro), frase en Noe Display y
// cifras grandes. Blanco y negro son los colores principales; el verde queda para detalles.
// A la izquierda del párrafo, la miniatura del reel (en bucle, sin sonido) con un botón de play;
// al hacer clic se abre el reel completo en un diálogo (src/scripts/reel.ts).
import { home } from '../../data/home';
import { langOf, ui } from '../../i18n';

const lang = langOf(Astro.url);
const { STUDIO } = home(lang);
const t = ui(lang);
const reel = lang === 'es' ? { open: 'Ver reel', close: 'Cerrar' } : { open: 'View reel', close: 'Close' };
---

<section class="h-studio" id="how-we-work">
  <p class="h-label" data-case-reveal><span>(02)</span> {t.nav[3]}</p>
  <h2 class="h-heading h-studio__title" data-case-reveal>{STUDIO.title}</h2>
  <div class="h-studio__row">
  <div class="h-studio__reel" data-case-reveal>
    <button type="button" class="h-reel" data-reel-open aria-label={reel.open}>
      <video
        class="h-reel__video"
        data-src="/media/reel/mattriz-reel-thumb.mp4"
        poster="/media/reel/mattriz-reel-thumb-poster.jpg"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"></video>
      <span class="h-reel__btn" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M9 6.5v11l9-5.5z" fill="currentColor" /></svg>
        <span class="h-reel__track"><span>Play</span><span>Play</span></span>
      </span>
    </button>
  </div>
  <div class="h-studio__body">
    <p class="h-studio__text" data-case-reveal>{STUDIO.text}</p>
    <a class="h-studio__cta" href="#projects" data-case-reveal>
      <span class="reveal"><span class="reveal__text" data-text={STUDIO.cta}>{STUDIO.cta}</span></span> <span class="btn-arrow" data-dir="down" aria-hidden="true">↓</span>
    </a>
  </div>
  </div>
  <ul class="h-studio__stats">
    {
      STUDIO.stats.map((s) => (
        <li data-case-reveal>
          <span class="h-studio__stat-label">{s.label}</span>
          <span class="h-studio__value" data-count>{s.value}</span>
          <span class="h-studio__stat-text">{s.text}</span>
        </li>
      ))
    }
  </ul>
</section>

<dialog class="h-reel-modal" data-reel-modal data-lenis-prevent aria-label={reel.open}>
  <button type="button" class="h-reel-modal__close" data-reel-close>{reel.close} <span aria-hidden="true">×</span></button>
  <div class="h-reel-modal__frame" tabindex="-1">
  <video
    class="h-reel-modal__video"
    data-full="/media/reel/mattriz-reel.mp4"
    data-full-mobile="/media/reel/mattriz-reel-m.mp4"
    data-poster="/media/reel/mattriz-reel-poster.jpg"
    poster="/media/reel/mattriz-reel-poster.jpg"
    muted
    loop
    playsinline
    disablepictureinpicture
    disableremoteplayback></video>
  </div>
</dialog>

<script>
  import '../../scripts/count-up';
  import '../../scripts/reel';
</script>

<style>
  /* Sigue el tema: negro en oscuro, claro en claro. */
  .h-studio {
    padding: clamp(80px, 12vw, 200px) var(--pad);
    background: var(--bg);
    color: var(--fg);
  }

  .h-studio :global(.h-label span) {
    color: var(--fg);
  }

  /* Reel a la izquierda (primeras 4 de 12 columnas) y el párrafo a la derecha, como antes. */
  .h-studio__row {
    display: grid;
    gap: 48px;
    margin-bottom: clamp(64px, 8vw, 140px);
  }

  @media (min-width: 1000px) {
    .h-studio__row {
      grid-template-columns: 4fr 8fr;
      gap: 0;
      align-items: start;
    }

    .h-studio__reel {
      padding-right: 4vw;
      padding-top: 0.45em;
    }
  }

  /* En celular el reel va después del párrafo. */
  @media (max-width: 999px) {
    .h-studio__reel {
      order: 2;
    }
  }

  .h-studio__body {
    display: grid;
    gap: 32px;
    justify-items: start;
    max-width: 58rem;
  }

  .h-reel {
    position: relative;
    display: block;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    /* La portada también como fondo: si el video no carga (modo de bajo consumo, datos), se ve igual. */
    background: #161616 url('/media/reel/mattriz-reel-thumb-poster.jpg') center / cover no-repeat;
    cursor: pointer;
    isolation: isolate;
  }

  .h-reel__video {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-reel:hover .h-reel__video {
    transform: scale(1.04);
  }

  /* Botón de play: una píldora con el ícono y "Play", con fondo desenfocado (se lee
     sobre cualquier color) y borde fino; al pasar el mouse se llena del rojo de marca. */
  .h-reel__btn {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px 8px 13px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    font-size: 14px;
    line-height: 1.2;
    white-space: nowrap;
    background: rgba(13, 13, 13, 0.22);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    color: var(--color-white);
    transform: translate(-50%, -50%);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      color 0.35s ease,
      transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
  }

  /* "Play" en marquesina: al pasar el mouse el texto corre en loop dentro del botón. La segunda
     copia va pegada a la derecha de la primera; el margen negativo quita el espacio de sobra. */
  .h-reel__track {
    position: relative;
    display: inline-block;
    overflow: hidden;
    margin-right: -0.9em;
    vertical-align: bottom;
  }

  .h-reel__track span {
    display: inline-block;
    padding-right: 0.9em;
  }

  .h-reel__track span + span {
    position: absolute;
    top: 0;
    left: 100%;
  }

  .h-reel:is(:hover, :focus-visible) .h-reel__track span {
    animation: h-reel-marquee 2.4s linear infinite;
  }

  @keyframes h-reel-marquee {
    to { transform: translateX(-100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-reel:is(:hover, :focus-visible) .h-reel__track span {
      animation: none;
    }
  }

  .h-reel__btn svg {
    width: 14px;
    height: 14px;
  }

  .h-reel:hover .h-reel__btn,
  .h-reel:focus-visible .h-reel__btn {
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: var(--color-white);
    transform: translate(-50%, -50%);
  }

  .h-reel:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
  }

  /* Reel completo */
  .h-reel-modal {
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 64px);
    border: 0;
    background: rgba(13, 13, 13, 0.9);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    color: var(--color-white);
  }

  .h-reel-modal[open] {
    display: grid;
    place-items: center;
    animation: h-reel-in 0.4s ease both;
  }

  .h-reel-modal::backdrop {
    background: transparent;
  }

  @keyframes h-reel-in {
    from {
      opacity: 0;
    }
  }

  /* Al abrir, el reel entra desenfocado y se va enfocando (el único lugar del sitio con este efecto). */
  .h-reel-modal[open] .h-reel-modal__frame {
    animation: h-reel-focus 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  }

  @keyframes h-reel-focus {
    from {
      filter: blur(24px);
      opacity: 0;
      transform: scale(0.97);
    }
    40% {
      opacity: 1;
    }
    to {
      filter: blur(0);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-reel-modal[open] .h-reel-modal__frame {
      animation: none;
    }
  }

  /* Marco con las esquinas redondeadas: siempre 16:9 y del tamaño exacto del video. */
  .h-reel-modal__frame {
    width: min(100%, 1600px, calc((100dvh - 140px) * 16 / 9));
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    isolation: isolate;
  }

  .h-reel-modal__frame:focus {
    outline: none;
  }

  .h-reel-modal__video {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  .h-reel-modal__close {
    position: absolute;
    top: clamp(16px, 3vw, 32px);
    right: clamp(16px, 3vw, 32px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: var(--btn-pad);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--btn-radius);
    background: transparent;
    color: var(--color-white);
    font-size: 15px;
    cursor: pointer;
  }

  .h-reel-modal__close span {
    font-size: 20px;
    line-height: 1;
  }

  .h-studio__text {
    font-size: clamp(22px, 2.2vw, 36px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .h-studio__cta {
    white-space: nowrap;
    display: inline-flex;
    gap: 0.5em;
    padding: var(--btn-pad);
    border-radius: var(--btn-radius);
    background: var(--fg);
    color: var(--bg);
    font-size: 16px;
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-studio__cta:hover {
    transform: scale(1.04);
  }

  .h-studio__stats {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 690px) {
    .h-studio__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4vw;
    }
  }

  .h-studio__stats li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .h-studio__stat-label {
    font-size: 15px;
    color: var(--muted);
  }

  .h-studio__value {
    font-family: var(--font-display);
    font-size: clamp(64px, 8vw, 140px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .h-studio__stat-text {
    max-width: 22em;
    font-size: 16px;
    line-height: 1.5;
  }
</style>
