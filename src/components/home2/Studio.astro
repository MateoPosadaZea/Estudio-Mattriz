---
// v2: "One studio. Real systems." en un bloque blanco con texto negro, frase en Noe Display y
// cifras grandes. Blanco y negro son los colores principales; el verde queda para detalles.
import { home } from '../../data/home';
import { SITE } from '../../data/site';
import { langOf, ui } from '../../i18n';

const lang = langOf(Astro.url);
const { STUDIO } = home(lang);
const t = ui(lang);
---

<section class="h-studio" id="how-we-work">
  <p class="h-label" data-case-reveal><span>(02)</span> {t.nav[1]}</p>
  <h2 class="h-heading h-studio__title" data-case-reveal>{STUDIO.title}</h2>
  <div class="h-studio__body">
    <p class="h-studio__text" data-case-reveal>{STUDIO.text}</p>
    <a class="h-studio__cta" href={SITE.calendly} target="_blank" rel="noopener" data-case-reveal>
      {STUDIO.cta} <span aria-hidden="true">↗</span>
    </a>
  </div>
  <ul class="h-studio__stats">
    {
      STUDIO.stats.map((s) => (
        <li data-case-reveal>
          <span class="h-studio__stat-label">{s.label}</span>
          <span class="h-studio__value" data-count>{s.value}</span>
          <span class="h-studio__stat-text">{s.text}</span>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import '../../scripts/count-up';
</script>

<style>
  .h-studio {
    --muted: rgba(0, 0, 0, 0.62);
    --line: rgba(0, 0, 0, 0.2);
    padding: clamp(80px, 12vw, 200px) var(--pad);
    background: var(--color-white);
    color: var(--color-black);
  }

  .h-studio :global(.h-label span) {
    color: var(--color-black);
  }

  .h-studio__body {
    display: grid;
    gap: 32px;
    justify-items: start;
    max-width: 58rem;
    margin-bottom: clamp(64px, 8vw, 140px);
  }

  @media (min-width: 1000px) {
    .h-studio__body {
      margin-left: calc(4 / 12 * 100%);
    }
  }

  .h-studio__text {
    font-size: clamp(22px, 2.2vw, 36px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .h-studio__cta {
    display: inline-flex;
    gap: 0.5em;
    padding: 14px 24px;
    border-radius: var(--radius-pill);
    background: var(--color-black);
    color: var(--color-white);
    font-size: 16px;
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-studio__cta:hover {
    transform: scale(1.04);
  }

  .h-studio__stats {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 690px) {
    .h-studio__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4vw;
    }
  }

  .h-studio__stats li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .h-studio__stat-label {
    font-size: 15px;
    color: var(--muted);
  }

  .h-studio__value {
    font-family: var(--font-display);
    font-size: clamp(64px, 8vw, 140px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .h-studio__stat-text {
    max-width: 22em;
    font-size: 16px;
    line-height: 1.5;
  }
</style>
