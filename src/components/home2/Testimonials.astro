---
// v2: testimonios en carrusel. Cada diapositiva: la cita a un lado y, al otro, el proyecto del
// cliente con sus imágenes pasando rápido y el enlace al caso. Los clientes sin caso en el sitio
// (My Doll Hair, Closet Up) muestran su logo. Lógica en src/scripts/testimonials.ts.
// Accesible: botones anterior/siguiente, pausa, contador; con prefers-reduced-motion no avanza solo.
// En /contact/ va sin título (bare), en una columna (imagen arriba, cita abajo).
import { home } from '../../data/home';
import { langOf, localize } from '../../i18n';

type Testimonial = { quote: string; name: string; company: string; avatar?: string };

interface Props {
  /** Sin etiqueta ni título de sección, en una sola columna. */
  bare?: boolean;
  /** Testimonios que van antes de los del home. */
  lead?: Testimonial[];
  /** Nombre accesible del carrusel cuando no hay título visible. */
  label?: string;
}

const { bare = false, lead = [], label } = Astro.props;
const lang = langOf(Astro.url);
const { LABELS } = home(lang);
const TESTIMONIALS: Testimonial[] = [...lead, ...home(lang).TESTIMONIALS];

const P = '/media/projects';
// Proyecto de cada cliente (por empresa). Imágenes del caso, en el orden en que pasan.
const PROJECTS: Record<string, { href: string; images: string[] }> = {
  'Spot On Mobile California': {
    href: '/project/spot-on-mobile-wash-detailing/',
    images: [`${P}/spot-on-case/spot-on-hero-1200.webp`, `${P}/spot-on-case/spot-on-booking-1200.webp`, `${P}/spot-on-case/spot-on-calendar-1200.webp`, `${P}/spot-on-case/spot-on-corporate-1200.webp`],
  },
  'Posada Cárcamo Abogados': {
    href: '/project/posada-carcamo-abogados/',
    images: [`${P}/posada-carcamo-abogados/jmb7973-scaled-1-1200.webp`, `${P}/posada-carcamo-abogados/mockup-scaled-1200.webp`, `${P}/posada-carcamo-abogados/portrait3-scaled-1200.webp`, `${P}/posada-carcamo-abogados/mockup-2-recuperado35-1200.webp`],
  },
  'AGL Vans Tours': {
    href: '/project/aglvanstours/',
    images: [`${P}/aglvanstours/mockup-scaled-1200.webp`, `${P}/aglvanstours/grabacion-de-pantalla-2025-03-11-a-las-11-49-16-p-m-poster.webp`, `${P}/aglvanstours/bioseguridadagl-poster.webp`, `${P}/aglvanstours/mockupagl-1-poster.webp`],
  },
};

const total = TESTIMONIALS.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class:list={['h-t', bare ? 'h-t--bare' : 'h-section']} aria-labelledby={bare ? undefined : 'h-testimonials-title'} aria-label={bare ? label : undefined}>
  {
    !bare && (
      <>
        <p class="h-label" data-case-reveal>
          <span>(05)</span>
        </p>
        <h2 class="h-heading" id="h-testimonials-title" data-case-reveal>
          {LABELS.testimonials}
        </h2>
      </>
    )
  }

  <div class="h-t__carousel" role="region" aria-roledescription="carousel" aria-labelledby={bare ? undefined : 'h-testimonials-title'} aria-label={bare ? label : undefined} data-t-carousel data-case-reveal>
    <div class="h-t__slides">
      {
        TESTIMONIALS.map((q, i) => {
          const project = PROJECTS[q.company];
          return (
            <div
              class:list={['h-t__slide', { 'is-active': i === 0 }]}
              role="group"
              aria-roledescription="slide"
              aria-label={LABELS.slideOf.replace('{n}', String(i + 1)).replace('{total}', String(total))}
              aria-hidden={i === 0 ? undefined : 'true'}
              inert={i === 0 ? undefined : true}
              data-t-slide
            >
              <div class="h-t__text">
                <blockquote class="h-t__quote">
                  <p>“{q.quote}”</p>
                </blockquote>
                <div class="h-t__who">
                  {q.avatar && <img src={q.avatar} width="56" height="56" alt="" loading="lazy" decoding="async" />}
                  <span>
                    <cite>{q.name}</cite>
                    <span>{q.company}</span>
                  </span>
                </div>
                {project && (
                  <a class="h-t__link" href={localize(project.href, lang)}>
                    {LABELS.viewProject} <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>

              {project ? (
                <a class="h-t__media" href={localize(project.href, lang)} tabindex="-1" aria-hidden="true" data-t-reel>
                  {project.images.map((src, k) => (
                    <img class:list={{ 'is-on': k === 0 }} src={src} width="1200" height="900" alt="" loading="lazy" decoding="async" />
                  ))}
                  <span class="h-t__media-tag">{LABELS.viewProject} ↗</span>
                </a>
              ) : (
                <div class="h-t__media h-t__media--logo" aria-hidden="true">
                  <img src={q.avatar} width="300" height="300" alt="" loading="lazy" decoding="async" />
                  <span>{q.company}</span>
                </div>
              )}
            </div>
          );
        })
      }
    </div>

    <div class="h-t__controls">
      <p class="h-t__count" aria-hidden="true"><span data-t-current>01</span> / {pad(total)}</p>
      <span class="h-t__progress" aria-hidden="true"><span data-t-progress></span></span>
      <button type="button" class="h-t__btn" data-t-toggle aria-label={LABELS.pause} data-label-pause={LABELS.pause} data-label-play={LABELS.play}>
        <svg class="i-pause" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M7 4v12M13 4v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        <svg class="i-play" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M7 4.5v11l9-5.5z" fill="currentColor"></path></svg>
      </button>
      <button type="button" class="h-t__btn" data-t-prev aria-label={LABELS.previous}>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M16 10H4M9 5l-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button type="button" class="h-t__btn" data-t-next aria-label={LABELS.next}>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>
  </div>
</section>

<script>
  import '../../scripts/testimonials';
</script>

<style>
  /* Todo el bloque (título, diapositiva y controles) cabe en una pantalla: así se ve que es un
     carrusel y que hay más. La altura de la imagen depende del alto de la ventana. */
  .h-t :global(.h-heading) {
    margin-bottom: clamp(24px, 4vh, 48px);
  }

  .h-t__slides {
    display: grid;
  }

  /* Todas las diapositivas en la misma celda; solo la activa se ve. */
  .h-t__slide {
    grid-area: 1 / 1;
    display: grid;
    gap: 32px;
    align-items: center;
    visibility: hidden;
    transition: visibility 0s 0.9s;
  }

  .h-t__slide.is-active {
    visibility: visible;
    transition: none;
  }

  @media (min-width: 1000px) {
    .h-t:not(.h-t--bare) .h-t__slide {
      grid-template-columns: 6fr 5fr;
      gap: 5vw;
    }
  }

  /* Versión en columna (contacto): imagen arriba y cita debajo. */
  .h-t--bare .h-t__slide {
    gap: 24px;
    align-items: start;
  }

  .h-t--bare .h-t__slide .h-t__media {
    order: -1;
    height: clamp(180px, 30vh, 340px);
  }

  .h-t--bare .h-t__slide .h-t__quote {
    font-size: clamp(18px, 1.4vw, 22px);
  }

  .h-t--bare .h-t__slide .h-t__text {
    gap: 20px;
  }

  @media (max-width: 999px) {
    .h-t__slide {
      gap: 20px;
    }

    .h-t__slide .h-t__media {
      order: -1;
      height: clamp(140px, 24vh, 240px);
    }

    .h-t__slide .h-t__text {
      gap: 18px;
    }

    .h-t__slide .h-t__quote {
      font-size: 18px;
    }

    .h-t__slide .h-t__who img {
      width: 44px;
      height: 44px;
    }
  }

  /* Texto: sube y aparece; al salir se desvanece. */
  .h-t__text {
    display: flex;
    flex-direction: column;
    gap: 32px;
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.4s,
      transform 0.8s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-t__slide.is-active .h-t__text {
    opacity: 1;
    transform: none;
    transition-delay: 0.2s;
  }

  .h-t__quote {
    margin: 0;
    font-size: clamp(21px, 2vw, 32px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    text-indent: -0.4em;
  }

  .h-t__who {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    line-height: 1.4;
  }

  .h-t__who img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .h-t__who span {
    display: flex;
    flex-direction: column;
  }

  .h-t__who cite {
    font-style: normal;
  }

  .h-t__who span span {
    color: var(--muted);
  }

  .h-t__link {
    align-self: flex-start;
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    font-size: 16px;
  }

  .h-t__link span {
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-t__link:hover span {
    transform: translateX(4px);
  }

  /* Media: se revela con una cortina desde abajo; las imágenes pasan rápido (testimonials.ts). */
  .h-t__media {
    position: relative;
    display: block;
    overflow: hidden;
    height: clamp(200px, 42vh, 440px);
    border-radius: 14px;
    background: color-mix(in srgb, var(--fg) 5%, transparent);
    clip-path: inset(100% 0 0 0 round 14px);
    transition: clip-path 0.9s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .h-t__slide.is-active .h-t__media {
    clip-path: inset(0 0 0 0 round 14px);
  }

  .h-t__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.3s,
      transform 2.4s ease-out;
  }

  .h-t__media img.is-on {
    opacity: 1;
    transform: scale(1);
  }

  .h-t__media-tag {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: rgba(10, 10, 10, 0.75);
    color: #ffffff;
    font-size: 14px;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .h-t__media:hover .h-t__media-tag {
    background: var(--color-brand-green);
    color: var(--color-black);
  }

  .h-t__media--logo {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 20px;
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .h-t__media--logo img {
    position: static;
    width: min(40%, 180px);
    height: auto;
    border-radius: 50%;
    opacity: 1;
    transform: none;
  }

  .h-t__media--logo span {
    font-family: var(--font-display);
    font-size: clamp(22px, 2vw, 32px);
  }

  /* Controles */
  .h-t__controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: clamp(20px, 3vh, 40px);
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .h-t__count {
    min-width: 5.5em;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }

  .h-t__progress {
    flex: 1;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .h-t__progress span {
    display: block;
    height: 100%;
    background: var(--color-brand-green);
    transform: scaleX(0);
    transform-origin: left;
  }

  .h-t__btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .h-t__btn:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .h-t__btn .i-play {
    display: none;
  }

  .h-t__carousel.is-paused .i-play {
    display: block;
  }

  .h-t__carousel.is-paused .i-pause {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .h-t__text,
    .h-t__media,
    .h-t__media img,
    .h-t__slide {
      transition: none;
    }
  }
</style>
