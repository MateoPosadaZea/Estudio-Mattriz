---
// v2: "Selected Work" como índice editorial. Los nombres de los proyectos, grandes y centrados; al
// pasar el mouse se enciende el activo (el resto se apaga), aparecen sus categorías y tres piezas
// del proyecto se dispersan alrededor (src/scripts/work-list.ts). En táctil se enciende el nombre
// que queda en el centro de la pantalla y se muestra su imagen debajo. Mismo orden y enlaces.
import { PROJECTS, home } from '../../data/home';
import { langOf, localize, category, ui } from '../../i18n';

const lang = langOf(Astro.url);
const { LABELS } = home(lang);
const t = ui(lang);

// Piezas de cada proyecto (public/media/work/list/<slug>-a|b|c.webp): a vertical 4:5, b horizontal
// 4:3, c vertical 3:4.
const LIST: Record<string, string> = {
  '/project/spot-on-mobile-wash-detailing/': 'spot-on',
  '/project/santo-y-sena/': 'santo-y-sena',
  '/project/the-grid/': 'the-grid',
  '/project/dr-daniel-de-zubiria/': 'dezubiria',
  '/project/posada-carcamo-abogados/': 'posada',
  '/project/aglvanstours/': 'agl',
  '/project/luciana-cabanas/': 'luciana',
  '/project/civilus/': 'civilus',
};

const items = PROJECTS.map((p) => ({
  title: p.title,
  href: localize(p.href, lang),
  categories: p.categories.map((c) => category(c, lang)),
  pics: ['a', 'b', 'c'].map((k) => `/media/work/list/${LIST[p.href]}-${k}.webp`),
}));
---

<section class="h-section h-work" id="projects" data-work>
  <!-- Alias del ancla anterior (#work), para los enlaces viejos que ya circulan. -->
  <span id="work" aria-hidden="true"></span>
  <p class="h-label" data-case-reveal><span>(03)</span> {t.nav[2]}</p>
  <h2 class="h-heading" data-case-reveal>{LABELS.selectedWork}</h2>

  <div class="h-work__stage" data-work-stage>
    <!-- Piezas que se dispersan alrededor del proyecto activo (solo con mouse). -->
    <div class="h-work__pics" aria-hidden="true">
      {
        items.map((p, i) => (
          <div class="h-work__set" data-work-set={i}>
            {p.pics.map((src, k) => (
              <span class={`h-work__pic h-work__pic--${'abc'[k]}`}>
                <img data-src={src} alt="" decoding="async" />
              </span>
            ))}
          </div>
        ))
      }
    </div>

    <ol class="h-work__list">
      {
        items.map((p, i) => (
          <li data-case-reveal>
            <a class="h-work__row" href={p.href} data-work-row={i}>
              <span class="h-work__name">
                {p.title}
                <span class="h-work__arrow" aria-hidden="true">↗</span>
              </span>
              <span class="h-work__cats">{p.categories.join(' · ')}</span>
              <span class="h-work__thumb" aria-hidden="true">
                <img data-src={p.pics[1]} alt="" decoding="async" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import '../../scripts/work-list';
</script>

<style>
  .h-work__stage {
    position: relative;
    margin-top: clamp(24px, 4vw, 56px);
  }

  .h-work__list {
    position: relative;
    z-index: 1;
    list-style: none;
    text-align: center;
  }

  .h-work__row {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: clamp(12px, 1.3vw, 18px) 0;
  }

  /* El nombre: Noe Display grande. Apagado mientras otro está activo; encendido el activo. */
  .h-work__name {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(34px, 4.6vw, 74px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    transition: color 0.45s ease;
  }

  .h-work__arrow {
    position: absolute;
    left: 100%;
    top: 0.08em;
    margin-left: 0.18em;
    font-family: var(--font-sans);
    font-size: 0.32em;
    letter-spacing: 0;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition:
      opacity 0.35s ease,
      transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-work__cats {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.45s ease;
  }

  .h-work__thumb {
    display: none;
  }

  /* Cuando hay un activo (mouse encima o, en táctil, el del centro), el resto se apaga. */
  .h-work.has-active .h-work__name,
  .h-work.has-active .h-work__cats {
    color: color-mix(in srgb, var(--fg) 16%, transparent);
  }

  .h-work.has-active .is-active .h-work__name {
    color: var(--fg);
  }

  .h-work.has-active .is-active .h-work__cats {
    color: var(--fg);
  }

  .is-active .h-work__arrow {
    opacity: 1;
    transform: none;
  }

  /* Piezas dispersas: capa detrás de los nombres; cada juego aparece alrededor del activo. */
  .h-work__pics {
    display: none;
  }

  @media (hover: hover) and (min-width: 1000px) {
    .h-work__pics {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .h-work__set {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--y, 0px);
      height: 0;
    }

    .h-work__pic {
      position: absolute;
      overflow: hidden;
      border-radius: 4px;
      background: color-mix(in srgb, var(--fg) 6%, transparent);
      opacity: 0;
      scale: 0.92;
      translate: var(--px, 0px) calc(var(--py, 0px) + 18px);
      transition:
        opacity 0.45s ease,
        scale 0.8s cubic-bezier(0.2, 1, 0.3, 1),
        translate 0.8s cubic-bezier(0.2, 1, 0.3, 1);
    }

    .h-work__pic img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .h-work__pic--a {
      left: 6%;
      top: -12vw;
      width: 13vw;
      aspect-ratio: 4 / 5;
    }

    .h-work__pic--b {
      right: 5%;
      top: -15vw;
      width: 16vw;
      aspect-ratio: 4 / 3;
    }

    .h-work__pic--c {
      right: 22%;
      top: 2vw;
      width: 10vw;
      aspect-ratio: 3 / 4;
    }

    .h-work__set.is-active .h-work__pic {
      opacity: 1;
      scale: 1;
      translate: var(--px, 0px) var(--py, 0px);
    }

    .h-work__set.is-active .h-work__pic--b {
      transition-delay: 0.06s;
    }

    .h-work__set.is-active .h-work__pic--c {
      transition-delay: 0.12s;
    }
  }

  /* Táctil o pantallas angostas: la imagen del activo aparece debajo de su nombre. */
  @media not ((hover: hover) and (min-width: 1000px)) {
    .h-work__thumb {
      display: block;
      width: min(100%, 420px);
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 4px;
      max-height: 0;
      opacity: 0;
      margin-top: 0;
      transition:
        max-height 0.6s cubic-bezier(0.2, 1, 0.3, 1),
        opacity 0.4s ease,
        margin-top 0.6s cubic-bezier(0.2, 1, 0.3, 1);
    }

    .h-work__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .is-active .h-work__thumb {
      max-height: 320px;
      opacity: 1;
      margin-top: 10px;
    }

    .h-work__arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-work__pic,
    .h-work__thumb {
      transition: opacity 0.2s ease !important;
    }
  }
</style>
