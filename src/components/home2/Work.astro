---
// v2: "Selected Work" como índice editorial. Los nombres de los proyectos, grandes y centrados; al
// pasar el mouse se enciende el activo (el resto se apaga), aparecen sus categorías y tres piezas
// del proyecto se dispersan alrededor (src/scripts/work-list.ts). En táctil se enciende el nombre
// que queda en el centro de la pantalla y se muestra su imagen debajo. Mismo orden y enlaces.
import fs from 'node:fs';
import { PROJECTS, home } from '../../data/home';
import { langOf, localize, category, ui } from '../../i18n';

const lang = langOf(Astro.url);
const { LABELS } = home(lang);
const t = ui(lang);

// Piezas de cada proyecto (public/media/work/list/<slug>-a|b|c): a vertical 4:5, b horizontal 4:3,
// c vertical 3:4. Si existe <slug>-x.mp4 la pieza es un loop corto (con su primer cuadro, -poster.webp); si no,
// la imagen fija.
const LIST: Record<string, string> = {
  '/project/spot-on-mobile-wash-detailing/': 'spot-on',
  '/project/santo-y-sena/': 'santo-y-sena',
  '/project/the-grid/': 'the-grid',
  '/project/dr-daniel-de-zubiria/': 'dezubiria',
  '/project/posada-carcamo-abogados/': 'posada',
  '/project/aglvanstours/': 'agl',
  '/project/luciana-cabanas/': 'luciana',
  '/project/civilus/': 'civilus',
};

const items = PROJECTS.map((p) => ({
  title: p.title,
  href: localize(p.href, lang),
  categories: p.categories.map((c) => category(c, lang)),
  pics: ['a', 'b', 'c'].map((k) => {
    const base = `/media/work/list/${LIST[p.href]}-${k}`;
    const video = fs.existsSync(`public${base}.mp4`);
    return { img: `${base}.webp`, video: video ? `${base}.mp4` : undefined, poster: video ? `${base}-poster.webp` : undefined };
  }),
}));
---

<section class="h-section h-work" id="projects" data-work>
  <!-- Alias del ancla anterior (#work), para los enlaces viejos que ya circulan. -->
  <span id="work" aria-hidden="true"></span>
  <p class="h-label" data-case-reveal><span>(03)</span> {t.nav[2]}</p>
  <h2 class="h-heading" data-case-reveal>{LABELS.selectedWork}</h2>

  <div class="h-work__stage" data-work-stage>
    <!-- Piezas que se dispersan alrededor del proyecto activo (solo con mouse). -->
    <div class="h-work__pics" aria-hidden="true">
      {
        items.map((p, i) => (
          <div class="h-work__set" data-work-set={i}>
            {p.pics.map((pic, k) => (
              <span class={`h-work__pic h-work__pic--${'abc'[k]}`}>
                {pic.video ? (
                  <video data-src={pic.video} data-poster={pic.poster} muted loop playsinline webkit-playsinline disablepictureinpicture disableremoteplayback preload="none" />
                ) : (
                  <img data-src={pic.img} alt="" decoding="async" />
                )}
              </span>
            ))}
          </div>
        ))
      }
    </div>

    <ol class="h-work__list">
      {
        items.map((p, i) => (
          <li data-case-reveal>
            <a class="h-work__row" href={p.href} data-work-row={i}>
              <span class="h-work__name">{p.title}</span>
              <span class="h-work__cats">{p.categories.join(' · ')}</span>
              <span class="h-work__thumb" aria-hidden="true">
                <img data-src={p.pics[1].img} alt="" decoding="async" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import '../../scripts/work-list';
</script>

<style>
  /* En esta sección el encabezado va centrado, como la lista. */
  .h-work :global(.h-label),
  .h-work :global(.h-heading) {
    text-align: center;
    justify-content: center;
    margin-left: auto;
    margin-right: auto;
  }

  .h-work__stage {
    position: relative;
    margin-top: clamp(24px, 4vw, 56px);
  }

  .h-work__list {
    position: relative;
    z-index: 1;
    list-style: none;
    text-align: center;
  }

  .h-work__row {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: clamp(12px, 1.3vw, 18px) 0;
  }

  /* El nombre: Maison Neue ligera, grande. Apagado mientras otro está activo; encendido el activo. */
  .h-work__name {
    position: relative;
    font-family: var(--font-sans);
    font-size: clamp(32px, 4.2vw, 68px);
    font-weight: var(--fw-light, 300);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
    transition: color 0.45s ease;
  }

  .h-work__cats {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.45s ease;
  }

  .h-work__thumb {
    display: none;
  }

  /* Cuando hay un activo (mouse encima o, en táctil, el del centro), el resto se apaga. */
  .h-work.has-active .h-work__name,
  .h-work.has-active .h-work__cats {
    color: color-mix(in srgb, var(--fg) 16%, transparent);
  }

  .h-work.has-active .is-active .h-work__name {
    color: var(--fg);
  }

  .h-work.has-active .is-active .h-work__cats {
    color: var(--fg);
  }

  /* Piezas dispersas: capa detrás de los nombres; cada juego aparece alrededor del activo. */
  .h-work__pics {
    display: none;
  }

  @media (hover: hover) and (min-width: 1000px) {
    .h-work__pics {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .h-work__set {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--y, 0px);
      height: 0;
    }

    .h-work__pic {
      position: absolute;
      overflow: hidden;
      border-radius: 4px;
      background: color-mix(in srgb, var(--fg) 6%, transparent);
      /* Fuera: más abajo, más pequeña y girada; al activarse entra a su lugar. */
      opacity: 0;
      scale: 0.8;
      rotate: var(--r0, -4deg);
      translate: var(--px, 0px) calc(var(--py, 0px) + 60px);
      transition:
        opacity 0.5s ease,
        scale 0.9s cubic-bezier(0.2, 1, 0.3, 1),
        rotate 0.9s cubic-bezier(0.2, 1, 0.3, 1),
        translate 0.9s cubic-bezier(0.2, 1, 0.3, 1);
    }

    .h-work__pic :is(img, video) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .h-work__pic--a {
      --r0: -6deg;
      --dur: 6.5s;
      left: 6%;
      top: -12vw;
      width: 13vw;
      aspect-ratio: 4 / 5;
    }

    .h-work__pic--b {
      --r0: 5deg;
      --dur: 8s;
      right: 5%;
      top: -15vw;
      width: 16vw;
      aspect-ratio: 4 / 3;
    }

    .h-work__pic--c {
      --r0: -3deg;
      --dur: 5.5s;
      right: 22%;
      top: 2vw;
      width: 10vw;
      aspect-ratio: 3 / 4;
    }

    /* Proyectos pares: la composición en espejo, para que no aparezcan siempre en el mismo sitio. */
    .h-work__set:nth-child(even) .h-work__pic--a {
      left: auto;
      right: 6%;
    }

    .h-work__set:nth-child(even) .h-work__pic--b {
      right: auto;
      left: 5%;
    }

    .h-work__set:nth-child(even) .h-work__pic--c {
      right: auto;
      left: 22%;
    }

    /* Activas: en su lugar, siguiendo al mouse (--px, --py, --rot desde work-list.ts) y flotando
       suave, cada una a su ritmo. */
    .h-work__set.is-active .h-work__pic {
      opacity: 1;
      scale: 1;
      rotate: var(--rot, 0deg);
      translate: var(--px, 0px) var(--py, 0px);
      animation: h-work-float var(--dur, 6s) ease-in-out infinite alternate;
    }

    .h-work__set.is-active .h-work__pic--b {
      transition-delay: 0.07s;
      animation-delay: -2s;
    }

    .h-work__set.is-active .h-work__pic--c {
      transition-delay: 0.14s;
      animation-delay: -4s;
    }

    @keyframes h-work-float {
      from {
        transform: translateY(-10px);
      }

      to {
        transform: translateY(10px);
      }
    }

    .h-work__set.is-active .h-work__pic--b {
      transition-delay: 0.06s;
    }

    .h-work__set.is-active .h-work__pic--c {
      transition-delay: 0.12s;
    }
  }

  /* Táctil o pantallas angostas: cada nombre lleva su imagen debajo, siempre en su lugar (así el
     scroll no salta); la del proyecto activo se enciende y las demás quedan atenuadas. */
  @media not ((hover: hover) and (min-width: 1000px)) {
    .h-work__row {
      padding: 22px 0;
    }

    .h-work__thumb {
      display: block;
      width: min(100%, 420px);
      aspect-ratio: 4 / 3;
      margin-top: 8px;
      overflow: hidden;
      border-radius: 4px;
      opacity: 0.28;
      filter: grayscale(1);
      transition:
        opacity 0.5s ease,
        filter 0.5s ease;
    }

    .h-work__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .is-active .h-work__thumb {
      opacity: 1;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-work__pic,
    .h-work__thumb {
      transition: opacity 0.2s ease, filter 0.2s ease !important;
      animation: none !important;
      rotate: none !important;
    }
  }
</style>
