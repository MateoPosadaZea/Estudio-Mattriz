---
// v2: entrada al escáner desde el home. Es un formulario GET a /scan/?url=… (funciona sin JS);
// la página del escáner arranca sola con esa URL.
import { scanCopy } from '../../data/scan';
import { langOf, localize } from '../../i18n';

const lang = langOf(Astro.url);
const c = scanCopy(lang);
---

<section class="h-section h-scan" aria-labelledby="h-scan-title">
  <p class="h-label" data-case-reveal><span>(04)</span> {c.teaserLabel}</p>
  <h2 class="h-heading" id="h-scan-title" data-case-reveal>{c.teaserTitle}</h2>
  <p class="h-scan__text" data-case-reveal>{c.teaserText}</p>
  <form class="h-scan__form" action={localize('/scan/', lang)} method="get" data-case-reveal>
    <label class="sr-only" for="h-scan-url">{c.inputLabel}</label>
    <input id="h-scan-url" name="url" type="text" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" placeholder={c.placeholder} required />
    <button type="submit">{c.button} <span aria-hidden="true">→</span></button>
  </form>
</section>

<style>
  .h-scan__text {
    max-width: 30em;
    margin: calc(-1 * clamp(16px, 2vw, 40px)) 0 clamp(32px, 4vw, 56px);
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.8);
  }

  .h-scan__form {
    display: flex;
    gap: 8px;
    max-width: 760px;
    padding: 8px 8px 8px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    transition: border-color 0.3s;
  }

  .h-scan__form:focus-within {
    border-color: var(--color-brand-green);
  }

  .h-scan__form input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--color-white);
    font: inherit;
    font-size: 20px;
    outline: none;
  }

  .h-scan__form input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .h-scan__form button {
    flex: none;
    padding: 16px 28px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-green);
    color: var(--color-black);
    font-size: 17px;
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-scan__form button:hover {
    transform: scale(1.04);
  }

  @media (max-width: 690px) {
    .h-scan__form {
      flex-direction: column;
      padding: 8px;
      border-radius: 20px;
    }

    .h-scan__form input {
      padding: 12px 14px;
    }
  }
</style>
