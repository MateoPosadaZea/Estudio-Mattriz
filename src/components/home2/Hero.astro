---
// v2: hero del home. Titular gigante en Noe Display que sube palabra por palabra,
// sobre el fondo del tema, y una franja inferior con el subtítulo y el enlace.
import { home } from '../../data/home';
import { langOf, ui } from '../../i18n';

const lang = langOf(Astro.url);
const { HERO } = home(lang);
const t = ui(lang);
---

<section class="h-hero">
  <div class="h-hero__inner">
    <div class="h-hero__head">
    <h1 class="h-hero__title" aria-label={HERO.title} style={`--em:${lang === 'es' ? 9.2 : 7.7}`}>
      {
        // En pantallas medianas y grandes, dos líneas partidas por la mitad de la frase.
        HERO.title.split(' ').map((w, i, all) => (
          <>
            <span class="case-mask" aria-hidden="true">
              <span style={`--d:${i * 70}ms`}>{[...w].map((ch) => <span class="h-c" data-c={ch}><span>{ch}</span></span>)}</span>
            </span>
            {i === Math.ceil(all.length / 2) - 1 && <br class="h-hero__br" />}
          </>
        ))
      }
    </h1>
    <!-- Aviso para seguir bajando, solo en celular: aparece si el visitante no ha bajado tras 15 s de
         lectura, y se va en cuanto baja. En escritorio no se muestra. -->
    <a class="h-scroll" href="#services" data-scroll-hint aria-hidden="true" tabindex="-1">
      <span>{HERO.scroll}</span>
      <i></i>
      <b class="h-scroll__icon"></b>
    </a>
    </div>
    <div class="h-hero__foot case-in" style="--d:500ms">
      <p class="h-hero__subtitle">{HERO.subtitle}</p>
      <a class="h-hero__cta" href={HERO.cta.href}>
        {HERO.cta.label} <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Titular: con el mouse encima, las letras cercanas pasan de Noe Display Medium a la Regular, más
  // delgada, poco a poco y más entre más cerca. Noe no es variable (pesos fijos): cada letra lleva su copia
  // en Regular en la misma celda (::after, alineada por la línea base), así las letras no se mueven.
  // El ciclo solo corre mientras hay algo que mover. Solo con mouse y sin "reducir movimiento".
  const title = document.querySelector<HTMLElement>('.h-hero__title');
  if (title && window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    const MAX = 1;
    // La Regular se pide al primer paso del mouse, no al cargar la página.
    title.addEventListener('pointerenter', () => title.classList.add('is-thin'), { once: true });
    const chars = [...title.querySelectorAll<HTMLElement>('.h-c')].map((el) => ({ el, v: 0 }));
    let x = 0;
    let y = 0;
    let inside = false;
    let raf = 0;
    const frame = () => {
      raf = 0;
      const r = Math.max(110, title.getBoundingClientRect().height * 0.85);
      let moving = false;
      for (const c of chars) {
        let t = 0;
        if (inside) {
          const b = c.el.getBoundingClientRect();
          const k = Math.max(0, 1 - Math.hypot(b.left + b.width / 2 - x, b.top + b.height / 2 - y) / r);
          t = k * k * (3 - 2 * k) * MAX;
        }
        let v = c.v + (t - c.v) * 0.1;
        if (Math.abs(t - v) < 0.002) v = t;
        if (v !== c.v) {
          c.v = v;
          c.el.style.setProperty('--k', v ? v.toFixed(3) : '');
          moving = true;
        }
      }
      if (moving || inside) raf = requestAnimationFrame(frame);
    };
    const kick = () => (raf ||= requestAnimationFrame(frame));
    title.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      inside = true;
      kick();
    });
    title.addEventListener('pointerleave', () => {
      inside = false;
      kick();
    });
  }

  // Solo en celular, y con tiempo: primero se lee, y si en 15 s nadie ha bajado, aparece el ícono.
  const hint = document.querySelector<HTMLElement>('[data-scroll-hint]');
  if (hint && window.matchMedia('(max-width: 699px)').matches) {
    const DELAY = 15000;
    const scrolled = () => window.scrollY > 40;
    const hide = () => {
      if (scrolled()) {
        hint.classList.remove('is-visible');
        window.removeEventListener('scroll', hide);
      }
    };
    setTimeout(() => {
      if (scrolled()) return;
      hint.classList.add('is-visible');
      window.addEventListener('scroll', hide, { passive: true });
    }, DELAY);
  }
</script>

<style>
  .h-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--header-top) + var(--header-height) + 40px) var(--pad) clamp(32px, 5vw, 64px);
    overflow: hidden;
  }

  @media (min-width: 700px) {
    .h-scroll {
      display: none !important;
    }
  }

  .h-hero__head {
    position: relative;
  }

  /* Pequeño y sutil, a la derecha del titular, alineado con su última línea: el texto y una línea
     que baja una y otra vez. */
  .h-scroll {
    position: absolute;
    right: 0;
    bottom: 0.4em;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--muted);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity 0.6s ease,
      transform 0.8s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-scroll.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  /* En celular, sin texto: solo un ícono animado (una píldora con un punto que baja), a la derecha
     para no tapar el enlace del hero ni la lectura. */
  .h-scroll__icon {
    display: none;
  }

  @media (max-width: 699px) {
    .h-scroll {
      position: fixed;
      right: var(--pad);
      bottom: 28px;
      transform: translateY(8px);
    }

    .h-scroll.is-visible {
      transform: none;
    }

    .h-scroll span,
    .h-scroll i {
      display: none;
    }

    .h-scroll__icon {
      position: relative;
      display: block;
      width: 16px;
      height: 26px;
      border: 1.4px solid currentColor;
      border-radius: 10px;
    }

    .h-scroll__icon::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 5px;
      width: 3px;
      height: 5px;
      margin-left: -1.5px;
      border-radius: 2px;
      background: currentColor;
      animation: h-scroll-dot 1.6s cubic-bezier(0.6, 0, 0.3, 1) infinite;
    }
  }

  @keyframes h-scroll-dot {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(9px); }
  }

  .h-scroll i {
    position: relative;
    width: 1px;
    height: 28px;
    overflow: hidden;
    background: var(--line);
  }

  .h-scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: currentColor;
    animation: h-scroll-line 1.8s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }

  @keyframes h-scroll-line {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .h-scroll i::after,
    .h-scroll__icon::after {
      animation: none;
    }
  }

  .h-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .h-hero__status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(20px, 2.4vw, 36px);
    font-size: 15px;
    color: var(--muted);
  }

  /* En pantallas medianas y grandes el título cabe en dos líneas: el tamaño se ajusta para que la
     mitad más larga de la frase (--em, medida en em de Noe Display) quepa en el ancho. */
  .h-hero__title {
    max-width: 11em;
    margin-left: -0.04em;
    font-family: var(--font-display);
    font-size: clamp(48px, 9vw, 136px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  /* Las dos versiones de la letra en la misma celda, alineadas por la línea base. */
  .is-thin .h-c {
    display: inline-grid;
    align-items: baseline;
    justify-items: center;
    color: color-mix(in srgb, currentColor calc((1 - var(--k, 0)) * 100%), transparent);
  }

  .is-thin .h-c > * {
    grid-area: 1 / 1;
  }

  .is-thin .h-c::after {
    content: attr(data-c);
    grid-area: 1 / 1;
    font-family: 'noe-display-regular', var(--font-display);
    font-weight: 400;
    color: var(--fg);
    /* La Regular llega entera pronto y la Medium se va desvaneciendo encima: el peso baja poco a poco,
       sin quedar gris a medio camino. */
    opacity: min(1, calc(var(--k, 0) * 3));
    pointer-events: none;
  }

  .h-hero__br {
    display: none;
  }

  @media (min-width: 700px) {
    .h-hero__br {
      display: inline;
    }

    .h-hero__title {
      max-width: none;
      /* 80 % del ancho para la línea más larga, tope 136 px. */
      font-size: clamp(48px, min(9.6vw, calc((100vw - 2 * var(--pad)) * 0.8 / var(--em, 9.4))), 136px);
    }
  }

  .h-hero__foot {
    display: grid;
    gap: 24px;
    margin-top: clamp(32px, 4vw, 64px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 1000px) {
    .h-hero__foot {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 6vw;
    }
  }

  .h-hero__subtitle {
    max-width: 30em;
    font-size: clamp(20px, 1.9vw, 30px);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .h-hero__cta {
    justify-self: start;
    display: inline-flex;
    gap: 0.5em;
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    font-size: 17px;
    white-space: nowrap;
  }

  .h-hero__cta span {
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-hero__cta:hover span {
    transform: translateY(3px);
  }
</style>
