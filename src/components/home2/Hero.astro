---
// v2: hero del home. Titular gigante en Noe Display que sube palabra por palabra,
// el gradiente verde de marca detrás, y una franja inferior con el subtítulo y el enlace.
// A la derecha del titular, una miniatura del reel (en bucle, sin sonido) con el botón "View reel";
// al hacer clic se abre el reel completo en un diálogo (src/scripts/reel.ts).
import AnimatedGradient from '../AnimatedGradient.astro';
import { home } from '../../data/home';
import { langOf, ui } from '../../i18n';

const lang = langOf(Astro.url);
const { HERO } = home(lang);
const t = ui(lang);
const reel = lang === 'es' ? { open: 'Ver reel', close: 'Cerrar' } : { open: 'View reel', close: 'Close' };
---

<section class="h-hero">
  <AnimatedGradient color1="brand" speed={250} blend="organic" />
  <div class="h-hero__inner">
    <div class="h-hero__top">
    <h1 class="h-hero__title" aria-label={HERO.title} style={`--em:${lang === 'es' ? 9.2 : 7.7}`}>
      {
        // En pantallas medianas y grandes, dos líneas partidas por la mitad de la frase.
        HERO.title.split(' ').map((w, i, all) => (
          <>
            <span class="case-mask" aria-hidden="true">
              <span style={`--d:${i * 70}ms`}>{w}</span>
            </span>
            {i === Math.ceil(all.length / 2) - 1 && <br class="h-hero__br" />}
          </>
        ))
      }
    </h1>
    <button type="button" class="h-reel case-in" style="--d:600ms" data-reel-open>
      <video
        class="h-reel__video"
        data-src="/media/reel/mattriz-reel-thumb.mp4"
        poster="/media/reel/mattriz-reel-poster.jpg"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"></video>
      <span class="h-reel__btn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        {reel.open}
      </span>
    </button>
    </div>
    <div class="h-hero__foot case-in" style="--d:500ms">
      <p class="h-hero__subtitle">{HERO.subtitle}</p>
      <a class="h-hero__cta" href={HERO.cta.href}>
        {HERO.cta.label} <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<dialog class="h-reel-modal" data-reel-modal data-lenis-prevent aria-label={reel.open}>
  <button type="button" class="h-reel-modal__close" data-reel-close>{reel.close} <span aria-hidden="true">×</span></button>
  <div class="h-reel-modal__frame">
  <video
    class="h-reel-modal__video"
    data-full="/media/reel/mattriz-reel.mp4"
    data-full-mobile="/media/reel/mattriz-reel-m.mp4"
    poster="/media/reel/mattriz-reel-poster.jpg"
    muted
    loop
    playsinline
    disablepictureinpicture
    disableremoteplayback></video>
  </div>
</dialog>

<script>
  import '../../scripts/reel';
</script>

<style>
  .h-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--header-top) + var(--header-height) + 40px) var(--pad) clamp(32px, 5vw, 64px);
    overflow: hidden;
  }

  .h-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .h-hero__status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(20px, 2.4vw, 36px);
    font-size: 15px;
    color: var(--muted);
  }

  /* En pantallas medianas y grandes el título cabe en dos líneas: el tamaño se ajusta para que la
     mitad más larga de la frase (--em, medida en em de Noe Display) quepa en el ancho. */
  .h-hero__title {
    max-width: 11em;
    margin-left: -0.04em;
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 112px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  .h-hero__br {
    display: none;
  }

  @media (min-width: 700px) {
    .h-hero__br {
      display: inline;
    }

    .h-hero__title {
      max-width: none;
      /* Contenido para que no compita con el logo: 64 % del ancho para la línea más larga, tope 112 px. */
      font-size: clamp(44px, min(6.4vw, calc((100vw - 2 * var(--pad)) * 0.64 / var(--em, 9.4))), 112px);
    }
  }

  /* Titular a la izquierda y miniatura del reel a la derecha, alineada abajo con el titular. */
  .h-hero__top {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 1000px) {
    .h-hero__top {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 4vw;
    }
  }

  .h-reel {
    position: relative;
    display: block;
    width: min(100%, 360px);
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #161616;
    cursor: pointer;
    isolation: isolate;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    transform: translateZ(0);
  }

  @media (min-width: 1000px) {
    .h-reel {
      width: clamp(280px, 25vw, 460px);
      margin-bottom: 0.4em;
    }
  }

  .h-reel__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-reel:hover .h-reel__video {
    transform: scale(1.04);
  }

  .h-reel__btn {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px 12px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-black);
    font-size: 15px;
    white-space: nowrap;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    transform: translate(-50%, -50%);
    transition: transform 0.5s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-reel__btn svg {
    width: 16px;
    height: 16px;
  }

  .h-reel:hover .h-reel__btn,
  .h-reel:focus-visible .h-reel__btn {
    transform: translate(-50%, -50%) scale(1.06);
  }

  .h-reel:focus-visible {
    outline: 2px solid var(--color-brand-green);
    outline-offset: 4px;
  }

  /* Reel completo */
  .h-reel-modal {
    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 64px);
    border: 0;
    background: rgba(10, 10, 10, 0.94);
    color: var(--color-white);
  }

  .h-reel-modal[open] {
    display: grid;
    place-items: center;
    animation: h-reel-in 0.4s ease both;
  }

  .h-reel-modal::backdrop {
    background: transparent;
  }

  @keyframes h-reel-in {
    from {
      opacity: 0;
    }
  }

  /* Marco con las esquinas redondeadas: siempre 16:9 y del tamaño exacto del video. */
  .h-reel-modal__frame {
    width: min(100%, 1600px, calc((100dvh - 140px) * 16 / 9));
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    transform: translateZ(0);
  }

  .h-reel-modal__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .h-reel-modal__close {
    position: absolute;
    top: clamp(16px, 3vw, 32px);
    right: clamp(16px, 3vw, 32px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-white);
    font-size: 15px;
    cursor: pointer;
  }

  .h-reel-modal__close span {
    font-size: 20px;
    line-height: 1;
  }

  .h-hero__foot {
    display: grid;
    gap: 24px;
    margin-top: clamp(32px, 4vw, 64px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 1000px) {
    .h-hero__foot {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 6vw;
    }
  }

  .h-hero__subtitle {
    max-width: 30em;
    font-size: clamp(19px, 1.7vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .h-hero__cta {
    justify-self: start;
    display: inline-flex;
    gap: 0.5em;
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    font-size: 17px;
    white-space: nowrap;
  }

  .h-hero__cta span {
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .h-hero__cta:hover span {
    transform: translateY(3px);
  }
</style>
