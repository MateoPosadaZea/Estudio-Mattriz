---
// Tarjetas de otros proyectos al final de los casos (nectar-post-grid del vivo): 3 columnas,
// tarjetas cuadradas con radio de 25px, categorías arriba y título abajo a la izquierda.
import { PROJECTS } from '../../data/home';
import { langOf, localize, category } from '../../i18n';

const lang = langOf(Astro.url);

interface Props {
  current: string;
}
const { current } = Astro.props;
const i = PROJECTS.findIndex((p) => p.href === `/project/${current}/`);
const others = [1, 2, 3].map((n) => PROJECTS[(i + n) % PROJECTS.length]);
---

<ul class="explore-grid">
  {
    others.map((p) => (
      <li class="explore-card">
        <div class="explore-card__bg" aria-hidden="true">
          {p.video ? (
            <video data-src={p.video} muted loop playsinline preload="none" />
          ) : (
            p.image && <img src={p.image.src} srcset={p.image.srcset} sizes="(max-width: 999px) 90vw, 30vw" width={p.image.width} height={p.image.height} alt="" loading="lazy" decoding="async" />
          )}
        </div>
        <div class="explore-card__content">
          <p class="explore-card__cats">
            {p.categories.map((c) => <span>{category(c, lang)}</span>)}
          </p>
          <h3 class="explore-card__title">
            <a href={localize(p.href, lang)}>{p.title}</a>
          </h3>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .explore-grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -10px;
    color: var(--color-white);
  }

  .explore-card {
    position: relative;
    width: calc(33.32% - 20px);
    aspect-ratio: 1;
    margin: 10px;
    border-radius: 25px;
    overflow: hidden;
    background: #1a1a1a;
  }

  .explore-card__bg,
  .explore-card__bg img,
  .explore-card__bg video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .explore-card__bg {
    transition: transform 0.6s var(--ease-reveal);
  }

  .explore-card:hover .explore-card__bg {
    transform: scale(1.05);
  }

  /* Sombra abajo a la izquierda para que el título se lea sobre cualquier imagen. */
  .explore-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0) 45%);
    pointer-events: none;
  }

  .explore-card__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 35px;
  }

  .explore-card__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 14px;
    line-height: 14px;
  }

  .explore-card__cats span {
    padding: 7px 14px;
    border-radius: 200px;
    background: rgba(10, 10, 10, 0.2);
  }

  .explore-card__title {
    font-size: min(2vw, 54px);
    font-weight: 500;
    line-height: 1.3;
  }

  .explore-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (max-width: 999px) {
    .explore-card {
      width: calc(50% - 20px);
    }

    .explore-card__title {
      font-size: min(5vw, 54px);
    }
  }

  @media (max-width: 690px) {
    .explore-card {
      width: calc(100% - 20px);
    }

    .explore-card__title {
      font-size: 34px;
    }
  }
</style>
