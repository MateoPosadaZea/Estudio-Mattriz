---
// Imagen o video de un caso v2. Los videos se cargan al acercarse (src/scripts/lazy-video.ts).
import { srcset, largest } from '../project/tone';
import type { CaseMedia } from './extract';

interface Props {
  item: CaseMedia;
  sizes: string;
  eager?: boolean;
  /** Texto alternativo si la pieza no trae uno (las imágenes del vivo venían sin alt). */
  fallbackAlt?: string;
}
const { item, sizes, eager = false, fallbackAlt = '' } = Astro.props;
const m = item.local;
---

{
  item.type === 'img' ? (
    <img
      src={largest(m)}
      srcset={srcset(m)}
      sizes={sizes}
      width={m.width}
      height={m.height}
      alt={item.alt || item.caption || fallbackAlt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <video
      data-src={`${m.dir}/${m.base}.mp4`}
      poster={`${m.dir}/${m.base}-poster.webp`}
      width={m.width}
      height={m.height}
      muted
      loop
      playsinline webkit-playsinline disablepictureinpicture disableremoteplayback
      preload="none"
      aria-hidden="true"
    />
  )
}

<style>
  img,
  video {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
