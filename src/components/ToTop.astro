---
import { langOf, ui } from '../i18n';
const t = ui(langOf(Astro.url));
---

<!-- Botón "volver arriba": aparece después de bajar un poco más de una pantalla y medio, en celular y
     escritorio. Sin fondo: flecha grande con borde fino; mix-blend-mode: difference lo mantiene visible
     sobre fondos claros, oscuros y fotos. El enlace "Volver arriba" del footer usa el mismo código. -->
<a class="to-top" href="#top" aria-label={t.toTop} data-to-top>
  <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .to-top {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    color: #fff;
    background: transparent;
    mix-blend-mode: difference;
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .to-top.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .to-top svg {
    transition: transform 0.3s cubic-bezier(0.2, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .to-top:hover svg {
      transform: translateY(-3px);
    }
  }

  .to-top:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (max-width: 999px) {
    .to-top {
      width: 46px;
      height: 46px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top,
    .to-top svg {
      transition: none;
    }
  }
</style>

<script>
  import { scrollToY } from '../scripts/smooth-scroll';
  const button = document.querySelector<HTMLElement>('[data-to-top]');
  if (button) {
    const update = () => button.classList.toggle('is-visible', window.scrollY > window.innerHeight * 1.5);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
  // El botón flotante y el "Volver arriba" del footer: subir con JS (no depende del ancla #top).
  document.querySelectorAll<HTMLAnchorElement>('a[href="#top"]').forEach((link) =>
    link.addEventListener('click', (event) => {
      event.preventDefault();
      scrollToY(0);
      history.replaceState(null, '', location.pathname + location.search);
    }),
  );
</script>
