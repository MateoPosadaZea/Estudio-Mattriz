---
import SplitText from '../SplitText.astro';
import { PROJECTS } from '../../data/home';
---

<!--
  "Selected Work" en desktop (≥ 992px): lista vertical. Sección de cambio de color: el fondo
  de la página pasa a blanco. Al pasar por una fila se rellena de negro desde abajo y la
  imagen o video del proyecto sigue al cursor (src/scripts/follow-media.ts).
-->
<section class="work-list" data-page-bg="#FFFFFF" data-page-text="#0a0a0a">
  <div class="work-list__head" data-animate="fade-up">
    <SplitText as="h2" text="Selected Work" class="work-list__title" />
  </div>

  <ul class="work-list__items" data-follow-list>
    {
      PROJECTS.map((p) => (
        <li class="work-row" data-follow-item>
          <a href={p.href}>
            <span class="work-row__title">{p.title}</span>
            <svg class="work-row__arrow" width="20" height="20" viewBox="60 58 140 140" fill="currentColor" aria-hidden="true">
              <path d="M198,64V168a6,6,0,0,1-12,0V78.48L68.24,196.24a6,6,0,0,1-8.48-8.48L177.52,70H88a6,6,0,0,1,0-12H192A6,6,0,0,1,198,64Z" />
            </svg>
          </a>
          <div class="work-row__media" data-follow-media aria-hidden="true">
            {p.video ? (
              <video data-src={p.video} muted loop playsinline preload="none" />
            ) : (
              p.image && <img src={p.image.src} srcset={p.image.srcset} sizes="288px" width={p.image.width} height={p.image.height} alt="" loading="lazy" decoding="async" />
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work-list {
    padding: 10vw 5%;
    color: var(--page-text, var(--color-ink));
    transition: color 0.8s;
  }

  .work-list :global(.work-list__title) {
    max-width: 900px;
    font-size: 6vw;
    line-height: 1.1;
    font-weight: var(--fw-light);
    letter-spacing: var(--ls-tight);
  }

  .work-list :global(.work-list__title .split__word) {
    line-height: inherit;
  }

  .work-list__items {
    margin-top: 84px;
    border-top: 1px solid var(--color-black);
  }

  .work-row {
    position: relative;
    border-bottom: 1px solid var(--color-black);
  }

  .work-row a {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 25px 0;
    color: var(--color-black);
  }

  /* Relleno negro que crece desde abajo. Vivo: 0.6s cubic-bezier(0.1, 0.75, 0.5, 1). */
  .work-row a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-black);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.6s cubic-bezier(0.1, 0.75, 0.5, 1);
  }

  .work-row__title,
  .work-row__arrow {
    transition:
      transform 0.6s cubic-bezier(0.1, 0.75, 0.5, 1),
      color 0.6s cubic-bezier(0.1, 0.75, 0.5, 1);
  }

  .work-row__title {
    font-size: 46px;
    line-height: 1.3;
    font-weight: var(--fw-light);
    letter-spacing: var(--ls-tight);
  }

  .work-row__arrow {
    flex: none;
  }

  .work-row a:hover::before,
  .work-row a:focus-visible::before {
    transform: scaleY(1);
  }

  .work-row a:hover,
  .work-row a:focus-visible {
    color: var(--color-white);
  }

  .work-row a:hover .work-row__title,
  .work-row a:focus-visible .work-row__title {
    transform: translateX(14px);
  }

  .work-row a:hover .work-row__arrow,
  .work-row a:focus-visible .work-row__arrow {
    transform: translateX(-16px);
  }

  /* Imagen/video que sigue al cursor. Vivo: 288×216, radio 10, fijo. */
  .work-row__media {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1;
    width: 288px;
    height: 216px;
    overflow: hidden;
    border-radius: 10px;
    opacity: 0;
    pointer-events: none;
    clip-path: inset(7% round 10px);
    transition:
      opacity 0.25s,
      clip-path 0.6s cubic-bezier(0.1, 0.75, 0.5, 1);
  }

  .work-row__media.is-active {
    opacity: 1;
    clip-path: inset(0 round 10px);
  }

  .work-row__media video,
  .work-row__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 991px) {
    .work-list {
      display: none;
    }
  }
</style>

<script>
  import '../../scripts/follow-media';
</script>
