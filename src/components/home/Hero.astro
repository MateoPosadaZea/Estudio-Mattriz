---
import AnimatedGradient from '../AnimatedGradient.astro';
import SplitText from '../SplitText.astro';
import PillLink from '../PillLink.astro';
import { home } from '../../data/home';
import { langOf } from '../../i18n';

const { HERO } = home(langOf(Astro.url));
---

<section class="hero">
  <AnimatedGradient color1="#00ff7f" speed={250} blend="organic" />
  <div class="hero__inner">
    <div class="hero__title">
      <SplitText as="h1" text={HERO.title} effect="letters" delay={150} desktopOnly />
    </div>
    <div class="hero__side">
      <SplitText text={HERO.subtitle} class="hero__subtitle" />
      <PillLink href={HERO.cta.href} class="hero__cta">{HERO.cta.label}</PillLink>
    </div>
  </div>
</section>

<style>
  /* Vivo: alto mínimo 100vh, contenido centrado (debajo del header), 8 % de margen lateral
     y columnas internas con 13vw más. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: calc(var(--header-top) + var(--header-height)) 8% 0;
    background: var(--color-black);
    color: var(--color-white);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    padding: 0 13vw;
  }

  .hero__title :global(h1) {
    font-family: var(--font-display);
    font-size: 5vw;
    font-weight: 600;
    line-height: 1.14;
  }

  .hero__title :global(.split__word) {
    line-height: inherit;
  }

  /* Vivo: 10 % de padding izquierdo y 5 % superior, relativos al ancho de la columna. */
  .hero__side {
    padding: 5% 0 0 10%;
  }

  .hero__side :global(.hero__subtitle) {
    margin-top: 5px;
  }

  .hero__side :global(.hero__subtitle .split__word) {
    line-height: 1.2;
  }

  .hero__side :global(.hero__cta) {
    margin-top: 32px;
  }

  @media (max-width: 999px) {
    .hero__title :global(h1) {
      font-size: 10vw;
    }

    .hero__side {
      padding: 0;
    }
  }

  @media (max-width: 690px) {
    .hero {
      padding-left: 5%;
      padding-right: 5%;
      padding-top: calc(var(--header-top) + var(--header-height-mobile));
    }

    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__title {
      margin-bottom: 20px;
    }

    .hero__side :global(.hero__cta) {
      margin-top: 43px;
    }
  }
</style>
