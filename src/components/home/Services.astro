---
import SplitText from '../SplitText.astro';
import { home } from '../../data/home';
import { langOf } from '../../i18n';

const { SERVICES } = home(langOf(Astro.url));

// Vivo: el padding derecho de la columna de texto varía por ítem (5 % o 15 % del ancho;
// en teléfono el de 5 % queda en 24px).
const PAD = ['max(5vw, 23px)', '15vw', 'max(5vw, 23px)', 'max(5vw, 23px)', 'max(5vw, 23px)'];
---

<section class="services" id="services">
  <SplitText as="h2" text={SERVICES.title} stagger class="services__title" />
  {
    SERVICES.items.map((item, i) => (
      <>
        <div class="services__divider" data-animate="draw" />
        <div class="services__item">
          <div class="services__text" data-animate="fade-up" style={`--pad: ${PAD[i]}`}>
            <h3 class="services__name">{item.title}</h3>
            <p>{item.text}</p>
          </div>
          <SplitText as="p" text={String(i + 1).padStart(2, '0')} effect="letters" class="services__number" />
        </div>
      </>
    ))
  }
</section>

<style>
  .services {
    padding: 5vw 5%;
    background: var(--color-black);
    color: var(--color-white);
  }

  /* Vivo: 6vw, interlineado 11vw (deja el aire bajo el título), peso 300, −0.03em. */
  .services :global(.services__title) {
    font-size: 6vw;
    line-height: 11vw;
    font-weight: var(--fw-light);
    letter-spacing: var(--ls-tight);
    padding-bottom: 7px; /* padding: el margen colapsaría con el del divisor */
  }

  .services :global(.services__title .split__word) {
    line-height: inherit;
  }

  /* Línea de 1px con 22.5px arriba y abajo. */
  .services__divider {
    height: 1px;
    margin: 22.5px 0;
    background: var(--color-white);
  }

  .services__item {
    display: flex;
    align-items: center;
  }

  .services__text {
    flex: 0 0 66.6667%;
    padding-right: var(--pad);
  }

  .services__name {
    margin-bottom: 10px;
    font-size: max(2vw, 28px);
    line-height: max(2.2vw, 32px);
    /* Vivo: <strong> sobre la cara Light, el navegador sintetiza la negrita. */
    font-weight: 600;
    letter-spacing: var(--ls-tight);
  }

  .services :global(.services__number) {
    flex: 1;
    margin-bottom: 7px;
    text-align: right;
    font-size: 7vw;
    line-height: 1;
    font-weight: var(--fw-light);
    letter-spacing: var(--ls-tight);
  }

  .services :global(.services__number .split__word) {
    line-height: inherit;
  }

  @media (max-width: 999px) {
    .services {
      padding: 8.8vw 5% 17.6vw 20px;
    }

    .services :global(.services__title) {
      font-size: 8vw;
      line-height: 1.1;
    }

    .services :global(.services__number) {
      font-size: 70px;
    }
  }

  @media (max-width: 690px) {
    .services :global(.services__title) {
      font-size: 10vw;
    }

    .services__text {
      flex-basis: 83.3333%;
    }

    .services :global(.services__number) {
      font-size: 12vw;
    }
  }
</style>
