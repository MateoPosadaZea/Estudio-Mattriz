---
import SplitText from '../SplitText.astro';
import { PROJECTS, CATEGORIES, categorySlug, home } from '../../data/home';
import { langOf, localize, category } from '../../i18n';

const lang = langOf(Astro.url);
const { LABELS } = home(lang);
// En el vivo, las categorías de cada tarjeta enlazan a /project-type/… (redirige a la sección de proyectos).
const typeHref = (c: string) => (lang === 'es' ? '/es/#work' : `/project-type/${categorySlug(c)}/`);
---

<!--
  "Selected Work" en pantallas < 992px: tarjetas con barra de navegador, filtro por
  categoría y "Load More" (el vivo muestra 6). Lógica en src/scripts/work-grid.ts.
-->
<section class="work-grid">
  <div class="work-grid__head" data-animate="fade-up">
    <SplitText as="h2" text={LABELS.selectedWork} class="work-grid__title" />
  </div>

  <div class="work-grid__filters">
    <button type="button" class="work-grid__filter-toggle" aria-expanded="false" aria-controls="work-filters" data-filter-toggle>
      <span aria-hidden="true" class="work-grid__plus"></span>
      {LABELS.filter}
    </button>
    <div class="work-grid__filter-list" id="work-filters" data-filter-list hidden>
      <button type="button" data-filter="all" aria-pressed="true">{LABELS.all}</button>
      {CATEGORIES.map((c) => <button type="button" data-filter={categorySlug(c)} aria-pressed="false">{category(c, lang)}</button>)}
    </div>
  </div>

  <ul class="work-grid__cards" data-work-grid data-animate="cards">
    {
      PROJECTS.map((p) => (
        <li class="work-card" data-work-card data-categories={p.categories.map(categorySlug).join(' ')}>
          <div class="work-card__window" aria-hidden="true" />
          <div class="work-card__media">
            {p.video ? (
              <video data-src={p.video} muted loop playsinline preload="none" aria-hidden="true" />
            ) : (
              p.image && <img src={p.image.src} srcset={p.image.srcset} sizes="(max-width: 767px) 90vw, 45vw" width={p.image.width} height={p.image.height} alt={p.image.alt} loading="lazy" decoding="async" />
            )}
          </div>
          <div class="work-card__content">
            <h3 class="work-card__title">
              <a href={localize(p.href, lang)}>{p.title}</a>
            </h3>
            <p class="work-card__cats">
              {p.categories.map((c) => <a href={typeHref(c)}>{category(c, lang)}</a>)}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="work-grid__more">
    <button type="button" class="work-grid__more-btn" data-load-more>{LABELS.loadMore}</button>
  </div>
</section>

<style>
  .work-grid {
    display: none;
    padding: 5vw 5%;
    background: var(--color-black);
    color: var(--color-white);
    text-align: center;
  }

  @media (max-width: 991px) {
    .work-grid {
      display: block;
      padding: 17.6vw 5%;
    }
  }

  @media (max-width: 690px) {
    .work-grid {
      padding-left: 0;
    }
  }

  /* Vivo: 7px de margen del título + 25px de padding de la fila (tablet y teléfono). */
  .work-grid__head {
    padding-bottom: 32px;
  }

  .work-grid :global(.work-grid__title) {
    font-size: 8vw;
    line-height: 1.1;
    font-weight: var(--fw-light);
    letter-spacing: var(--ls-tight);
  }

  .work-grid :global(.work-grid__title .split__word) {
    line-height: inherit;
  }

  .work-grid__filters {
    max-width: 320px;
    margin: 0 auto;
    padding-top: 40px;
  }

  /* Vivo: píldora con borde blanco al 30 %, 14px/500, padding 10px 40px 10px 60px. */
  .work-grid__filter-toggle {
    position: relative;
    padding: 10px 40px 10px 60px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 500;
    line-height: 26px;
  }

  .work-grid__plus {
    position: absolute;
    left: 38px;
    top: 50%;
    width: 12px;
    height: 12px;
    transform: translateY(-50%);
  }

  .work-grid__plus::before,
  .work-grid__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 5.25px;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s;
  }

  .work-grid__plus::after {
    transform: rotate(90deg);
  }

  .work-grid__filter-toggle[aria-expanded='true'] .work-grid__plus::after {
    transform: rotate(0deg);
  }

  .work-grid__filter-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 20px;
    padding-top: 20px;
    font-size: 14px;
  }

  .work-grid__filter-list[hidden] {
    display: none;
  }

  .work-grid__filter-list button {
    opacity: 0.6;
  }

  .work-grid__filter-list button[aria-pressed='true'] {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .work-grid__cards {
    display: flex;
    flex-wrap: wrap;
    margin: 15px;
  }

  .work-card {
    position: relative;
    width: calc(50% - 30px);
    margin: 15px;
    border-radius: var(--radius-card);
    background: var(--color-white);
    color: var(--color-black);
    overflow: hidden;
    transition: background-color 0.32s;
  }

  .work-card[hidden] {
    display: none;
  }

  .work-card:hover {
    background: #ededed;
  }

  @media (max-width: 767px) {
    .work-card {
      width: calc(100% - 30px);
    }
  }

  /* Barra de "ventana de navegador": tres puntos y línea inferior. */
  .work-card__window {
    height: 26px;
    border-bottom: 1px solid #e0e0e0;
  }

  .work-card__window::before {
    content: '•••';
    display: block;
    padding-left: 12px;
    color: #9a9a9a;
    font-size: 14px;
    letter-spacing: 4px;
    line-height: 26px;
    text-align: left;
  }

  .work-card__media {
    height: 253px;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .work-card__media video,
  .work-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-card__content {
    padding: 35px 45px;
  }

  .work-card__title {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
  }

  /* Toda la tarjeta es clicable, como en el vivo. */
  .work-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .work-card__cats {
    font-size: 14px;
    line-height: 21px;
  }

  .work-card__cats a {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin: 10px 10px 0 0;
    line-height: 1.1;
  }

  .work-grid__more {
    margin: 60px 0;
  }

  .work-grid__more-btn {
    padding: 15px 35px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    transition: background-color 0.3s, border-color 0.3s, color 0.3s;
  }

  .work-grid__more-btn:hover {
    background: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-black);
  }

  .work-grid__more-btn[hidden] {
    display: none;
  }
</style>

<script>
  import '../../scripts/work-grid';
</script>
