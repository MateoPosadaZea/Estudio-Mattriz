---
// Botón píldora con borde y flecha curva ("See how we work", "Let's talk about your project").
// Vivo: borde 1px blanco, radio 100px, padding 15px 20px; hover: fondo y borde negros (0.45s).
interface Props {
  href: string;
  external?: boolean;
  class?: string;
}
const { href, external = false, class: className } = Astro.props;
---

<a class:list={['pill-link', 'arrow-link', className]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <span><slot /></span>
  <svg viewBox="0 0 22 22" aria-hidden="true">
    <g transform="matrix(1,0,0,-1,12,11)">
      <g transform="matrix(1,0,0,-1,-1,3)">
        <path class="line" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" d="M 7 3.3 L -3.2 3.3 C -5 3.3 -6.5 1.8 -6.5 0 L -6.5 -2.5"></path>
      </g>
      <g transform="matrix(1,0,0,-1,4,-0.5)">
        <path class="arrow" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" d="M -2.5 5 C -2.5 5 2.5 0 2.5 0"></path>
        <path class="arrow" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" d="M -2.5 -5 C -2.5 -5 2.5 0 2.5 0"></path>
      </g>
    </g>
  </svg>
</a>

<style>
  .pill-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 20px;
    border: 1px solid var(--color-white);
    border-radius: 100px;
    color: var(--color-white);
    line-height: 1;
    transition:
      border-color 0.45s var(--ease-reveal),
      background-color 0.45s var(--ease-reveal),
      color 0.45s var(--ease-reveal);
  }

  /* El ícono (20px) no debe estirar el alto: vivo 49px = texto 17 + padding 30 + borde 2. */
  .pill-link svg {
    margin: -1.5px 0;
  }

  .pill-link:hover {
    background-color: var(--color-black);
    border-color: var(--color-black);
  }
</style>
