---
// v2: pantalla de carga, lo más simple posible: solo "hola" en varios idiomas, pequeño y centrado en
// Noe Display (cierra en el idioma del sitio, con el punto rojo), y el fondo sube como un telón que
// descubre la página. El telón va en el color inverso al de la página (negro en el modo blanco,
// blanco en el oscuro, rojo en el rojo) para que su subida se vea. Solo en la primera página de la sesión.
//
// Nunca bloquea el sitio:
// - La clase html.is-loading la pone un script en <head> (Base.astro); sin JS no hay loader.
// - Con prefers-reduced-motion no aparece.
// - Si el script de abajo falla, el de <head> quita la clase a los 5 s.
// Mientras está, las entradas del hero quedan en pausa y arrancan cuando sube la cortina.
---

<div class="loader" aria-hidden="true" data-loader>
  <p class="loader__word" data-loader-word></p>
</div>

<script>
  import '../scripts/loader';
</script>

<style is:global>
  .loader {
    display: none;
  }

  html.is-loading .loader,
  .loader.is-leaving {
    clip-path: inset(0 0 0 0);
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: block;
    background: var(--fg);
    color: var(--bg);
  }

  html.is-loading {
    overflow: hidden;
  }

  /* Las entradas del hero esperan a que se vaya el loader. */
  html.is-loading .case-mask > span,
  html.is-loading .case-in {
    animation-play-state: paused;
  }

  /* Salida: el telón sube (el borde de abajo va hacia arriba) con una curva suave, y la palabra sube
     un poco y se desvanece antes de que la alcance. */
  .loader.is-leaving {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1.15s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .loader.is-leaving .loader__word {
    opacity: 0;
    transform: translateY(-24px);
    transition:
      opacity 0.45s ease,
      transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }

  /* Tras el loader, el titular y el resto del hero arrancan medio segundo después: suben mientras
     el telón los va descubriendo, no detrás de él. */
  html.after-loader.js .case-mask > span {
    animation-delay: calc(0.6s + var(--d, 0ms));
  }

  html.after-loader.js .case-in {
    animation-delay: calc(0.5s + var(--d, 0ms));
  }

  /* Solo el saludo, pequeño y centrado. */
  .loader__word {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .loader__word i {
    font-style: normal;
    color: var(--color-brand);
  }

  /* En el modo rojo el telón ya es rojo: el punto va del color del texto. */
  html[data-palette] .loader__word i {
    color: inherit;
  }
</style>
