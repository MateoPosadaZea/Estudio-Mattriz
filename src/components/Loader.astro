---
// v2: pantalla de carga, lo más simple posible: en blanco, solo "hola" en varios idiomas, pequeño y
// centrado en Noe Display (cierra en el idioma del sitio, con el punto en verde) y el fondo sube
// como un telón que se lleva la palabra. Solo en la primera página de la sesión.
//
// Nunca bloquea el sitio:
// - La clase html.is-loading la pone un script en <head> (Base.astro); sin JS no hay loader.
// - Con prefers-reduced-motion no aparece.
// - Si el script de abajo falla, el de <head> quita la clase a los 5 s.
// Mientras está, las entradas del hero quedan en pausa y arrancan cuando sube la cortina.
---

<div class="loader" aria-hidden="true" data-loader>
  <p class="loader__word" data-loader-word></p>
</div>

<script>
  import '../scripts/loader';
</script>

<style is:global>
  .loader {
    display: none;
  }

  html.is-loading .loader,
  .loader.is-leaving {
    clip-path: inset(0 0 0 0);
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: block;
    background: var(--color-white);
    color: var(--color-black);
  }

  html.is-loading {
    overflow: hidden;
  }

  /* Las entradas del hero esperan a que se vaya el loader. */
  html.is-loading .case-mask > span,
  html.is-loading .case-in {
    animation-play-state: paused;
  }

  /* Salida: el fondo sube como un telón (el borde de abajo va hacia arriba) y se lleva la palabra,
     que se queda quieta en su sitio. */
  .loader.is-leaving {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s cubic-bezier(0.7, 0, 0.2, 1);
  }

  /* Solo el saludo, pequeño y centrado. */
  .loader__word {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .loader__word i {
    font-style: normal;
    color: var(--color-brand);
  }
</style>
