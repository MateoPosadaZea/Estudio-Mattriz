---
// Ícono minimalista de mundo para el cambio de idioma (trazo fino, hereda el color del texto).
const { size = 18 } = Astro.props;
---

<svg class="globe-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
  <circle cx="12" cy="12" r="9"></circle>
  <ellipse cx="12" cy="12" rx="4" ry="9"></ellipse>
  <path d="M3 12h18"></path>
</svg>
