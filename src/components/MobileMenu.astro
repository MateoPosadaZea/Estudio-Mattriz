---
import { NAV, SITE } from '../data/site';
import ColorModes from './ColorModes.astro';
import { langOf, localize, alternate, ui } from '../i18n';

const path = Astro.url.pathname;
const lang = langOf(Astro.url);
const t = ui(lang);
const other = lang === 'es' ? 'en' : 'es';
---

<!--
  v2: menú mobile a pantalla completa en el verde de marca.
  Barra superior (logo + "Close"). Links en Noe Display centrados (referencia: locomotive.ca),
  que entran escalonados con máscara.
  Idioma y correo en las esquinas de abajo.
  La lógica está en src/scripts/menu.ts.
-->
<div class="mobile-menu" id="mobile-menu" data-lenis-prevent role="dialog" aria-modal="true" aria-label={t.menu} tabindex="-1" hidden>
  <div class="mobile-menu__bar">
    <a class="mobile-menu__logo" href={localize('/', lang)}>
      <span class="mobile-menu__word" aria-label="Mattriz Studio">Mattriz</span>
    </a>
    <button class="mobile-menu__close" type="button" data-menu-close aria-label={t.closeMenu}>
      <span class="mask"><span>{t.close}</span></span>
    </button>
  </div>

  <nav class="mobile-menu__nav" aria-label={t.menu}>
    <ul class="mobile-menu__list">
      {
        NAV.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={localize(item.href, lang)} aria-current={localize(item.href, lang) === path ? 'page' : undefined}>
              <span class="mask"><span>{t.nav[i]}</span></span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a class="mobile-menu__talk" href="#contact-form">
    <span class="mask"><span>{t.talk} ↓</span></span>
  </a>

  <div class="mobile-menu__foot">
    <div class="mobile-menu__prefs">
      <a class="mobile-menu__lang mask" href={alternate(Astro.url, other)} hreflang={other} lang={other}>
        <span>{t.switchLong}</span>
      </a>
      <ColorModes class="mobile-menu__theme" open />
    </div>
    <a class="mobile-menu__mail mask" href={`mailto:${SITE.email}`}><span>{SITE.email}</span></a>
  </div>
</div>

<style>
  .mobile-menu {
    /* Fondo negro y texto blanco: el verde queda solo para el botón. */
    /* Sigue el modo de color: blanco con texto negro, blanco con texto rojo o negro suave con
       texto blanco. */
    --menu-bg: var(--bg);
    --menu-fg: var(--fg);
    --menu-ease: cubic-bezier(0.7, 0, 0.2, 1);
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    padding: 0 6vw max(28px, env(safe-area-inset-bottom));
    background: var(--menu-bg);
    color: var(--menu-fg);
    /* Cortina: baja desde arriba al abrir y sube al cerrar. */
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--menu-ease);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
  }

  /* Misma altura y posición que la píldora del header para que el logo no salte. */
  .mobile-menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height-mobile);
    margin-top: var(--header-top);
  }

  /* Logotipo completo: "Mattriz" en Noe Display Bold, el peso de la M del logo (igual que el header). */
  .mobile-menu__word {
    display: inline-block;
    font-family: var(--font-logo);
    font-size: 32px;
    font-weight: 700;
    line-height: 0.74;
    padding-top: 0.06em;
    letter-spacing: -0.02em;
    color: var(--menu-fg);
  }

  .mobile-menu__close {
    padding: 12px 0 12px 12px;
    font-size: 18px;
    line-height: 1.2;
  }

  /* Links grandes en Noe Display, centrados en la pantalla (como el menú de locomotive.ca), a un
     tamaño menor que la primera versión. */
  .mobile-menu__nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
  }

  .mobile-menu__list {
    font-family: var(--font-display);
    font-size: clamp(38px, 11.5vw, 72px);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .mobile-menu__list a {
    display: block;
    padding: 0.04em 0;
  }

  .mobile-menu__talk {
    align-self: flex-start;
    margin-bottom: clamp(32px, 6vh, 56px);
    padding: 14px 24px;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    color: var(--color-white);
    font-size: 16px;
    line-height: 1.2;
  }

  .mobile-menu__talk .mask > span {
    --i: 5;
  }

  .mobile-menu__prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
  }

  /* Los modos de color entran con el pie del menú. */
  .mobile-menu :global(.mobile-menu__theme) {
    opacity: 0;
    transition: opacity 0.3s;
  }

  .mobile-menu.is-open :global(.mobile-menu__theme) {
    opacity: 1;
    transition: opacity 0.6s 0.6s;
  }

  .mobile-menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 16px;
    font-size: 16px;
    line-height: 1.4;
  }

  /* Máscara: el texto sube desde debajo de su propia línea. */
  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
  }

  .mask > span {
    display: inline-block;
    transform: translateY(105%);
    transition: transform 0.5s var(--menu-ease);
  }

  .mobile-menu__list .mask > span {
    padding-bottom: 0.06em;
  }

  .mobile-menu.is-open .mask > span {
    transform: none;
    transition: transform 0.9s cubic-bezier(0.2, 1, 0.3, 1);
    transition-delay: calc(0.3s + var(--i, 0) * 0.06s);
  }

  .mobile-menu.is-open .mobile-menu__bar .mask > span {
    transition-delay: 0.25s;
  }

  .mobile-menu.is-open .mobile-menu__foot .mask > span {
    transition-delay: 0.6s;
  }

  /* Subrayado del ítem actual y al pasar el mouse. */
  .mobile-menu__list .mask > span {
    background: linear-gradient(currentColor, currentColor) 0 92% / 0 1.5px no-repeat;
  }

  .mobile-menu__list a[aria-current='page'] .mask > span,
  .mobile-menu__list a:hover .mask > span {
    background-size: 100% 1.5px;
  }

  .mobile-menu:focus {
    outline: none;
  }

  .mobile-menu a:focus-visible,
  .mobile-menu button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mask > span,
    .mobile-menu.is-open .mask > span {
      transition: none;
    }

    .mobile-menu,
    .mask > span {
      clip-path: none;
      transform: none;
    }
  }
</style>
