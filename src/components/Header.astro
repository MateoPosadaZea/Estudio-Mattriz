---
import ThemeToggle from './ThemeToggle.astro';
import GlobeIcon from './GlobeIcon.astro';
import { NAV } from '../data/site';
import { langOf, localize, alternate, ui } from '../i18n';

const path = Astro.url.pathname;
const lang = langOf(Astro.url);
const t = ui(lang);
const other = lang === 'es' ? 'en' : 'es';
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <!-- v2: por ahora solo la M, en escritorio y en móvil (pedido de Mateo). -->
    <a class="site-header__logo" href={localize('/', lang)} aria-label="Mattriz Studio">
      <span class="site-header__word" aria-hidden="true">M<span class="site-header__rest">attriz</span></span>
    </a>

    <nav class="site-nav" aria-label={t.mainNav}>
      <ul>
        {
          NAV.map((item, i) => (
            <li>
              <a href={localize(item.href, lang)} aria-current={localize(item.href, lang) === path ? 'page' : undefined}>
                <span class="reveal">
                  <span class="reveal__text" data-text={t.nav[i]}>
                    {t.nav[i]}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Cambio de idioma: la misma página en el otro idioma. Solo el ícono de mundo (en móvil
         el idioma está dentro del menú). -->
    <a class="lang-switch" href={alternate(Astro.url, other)} hreflang={other} lang={other} aria-label={t.switchLabel} title={t.switchLabel}>
      <GlobeIcon size={20} />
    </a>

    <ThemeToggle class="site-header__theme" />

    <a class="talk-button" href="#contact-form">
      <span class="reveal">
        <span class="reveal__text" data-text={t.talk}>{t.talk}</span>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span class="sr-only">{t.menu}</span>
      <span class="menu-toggle__lines" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>
</header>


<script>
  // Header transparente arriba del todo; al bajar, píldora blanca. El tono (claro u oscuro) sale del
  // color de fondo de la página, para que logo, menú y botón se lean sobre cualquier portada.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const tone = () => {
      const bg = getComputedStyle(document.body).backgroundColor;
      const m = bg.match(/\d+(\.\d+)?/g)?.map(Number) ?? [255, 255, 255, 1];
      const [r, g, b, a = 1] = m;
      const lum = a === 0 ? 1 : (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
      header.dataset.tone = lum < 0.5 ? 'dark' : 'light';
    };
    const update = () => header.classList.toggle('is-top', window.scrollY < 24);
    tone();
    update();
    window.addEventListener('scroll', update, { passive: true });
    // El tema (claro/oscuro) puede cambiar con el botón del header.
    new MutationObserver(tone).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  /* Píldora blanca fija. Vivo: top 25px, alto 70px, radio 50px, 70px de margen lateral. */
  .site-header {
    position: fixed;
    top: var(--header-top);
    left: 0;
    right: 0;
    z-index: 100;
    width: calc(100% - 2 * var(--header-inset));
    max-width: var(--header-max-width);
    height: var(--header-height);
    margin: 0 auto;
    padding: 0 25px;
    background: var(--color-white);
    border-radius: var(--header-radius);
    color: var(--color-black);
    animation: header-entrance 1.5s ease forwards;
    transition:
      background-color 0.4s ease,
      box-shadow 0.4s ease,
      color 0.4s ease;
  }

  /* Arriba del todo la píldora es transparente y todo se adapta al fondo de la página
     (data-tone lo pone el script según el color de fondo). Al bajar vuelve la píldora blanca. */
  .site-header.is-top {
    background-color: transparent;
  }

  .site-header.is-top[data-tone='dark'] {
    color: var(--color-white);
  }

  .site-header.is-top[data-tone='dark'] .talk-button {
    color: var(--color-black);
  }

  .site-header.is-top[data-tone='dark'] .talk-button::before {
    background: var(--color-white);
  }

  .site-header.is-top .talk-button::after {
    display: none;
  }

  @keyframes header-entrance {
    from { opacity: 0.01; }
    to { opacity: 1; }
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
  }

  /* Logotipo: la palabra "Mattriz" en Noe Display, en su peso real (el del archivo), toda en texto
     para que la M y el resto tengan exactamente el mismo peso. Arriba del todo se ve completa; al
     bajar, "attriz" se recoge y queda la M. Toma el color del header (blanco arriba en fondos oscuros). */
  .site-header__word {
    display: inline-flex;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 500;
    /* Solo la altura de las mayúsculas (sin el espacio de descendentes), para que el logo quede
       centrado en vertical con el menú y los botones. */
    line-height: 0.74;
    padding-top: 0.06em;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .site-header__rest {
    display: inline-block;
    /* Solo recorta a lo ancho (para recogerse): arriba deja ver el punto de la i. */
    overflow: hidden;
    overflow: clip visible;
    padding-top: 0.2em;
    margin-top: -0.2em;
    max-width: 3.2em;
    transition:
      max-width 0.5s cubic-bezier(0.2, 1, 0.3, 1),
      opacity 0.3s ease;
  }

  .site-header:not(.is-top) .site-header__rest {
    max-width: 0;
    opacity: 0;
  }

  /* Menú centrado respecto a la píldora. */
  .site-nav {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .site-nav ul {
    display: flex;
  }

  .site-nav a {
    display: block;
    white-space: nowrap;
    padding: 0 20px;
    font-size: var(--fs-menu);
    font-weight: var(--fw-menu);
    line-height: 1.3;
  }

  /* Botón negro. Vivo: 116×49 px, 24px de padding, radio 200px.
     Hover: el fondo crece a 1.065 (0.45s) y aparece una sombra a 1.07 (0.3s); el texto no escala. */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
    padding: 10px 16px;
    font-size: var(--fs-menu);
    font-weight: var(--fw-menu);
    line-height: 1.3;
  }

  :global(.site-header__theme) {
    margin-right: 10px;
  }

  .talk-button {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    height: 49px;
    padding: 0 24px;
    color: var(--color-white);
    font-size: var(--fs-menu);
    font-weight: var(--fw-menu);
    line-height: 1.3;
  }

  .talk-button::before,
  .talk-button::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--radius-round);
  }

  .talk-button::before {
    background: var(--color-black);
    transition: transform 0.45s var(--ease-reveal);
  }

  .talk-button::after {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.13);
    opacity: 0;
    transition: opacity 0.3s, transform 0.3s;
  }

  .talk-button:hover::before {
    transform: scale(1.065);
  }

  .talk-button:hover::after {
    opacity: 1;
    transform: scale(1.07);
  }

  .menu-toggle {
    display: none;
  }

  /* Header compacto por debajo de 1280px: entre 1000 y 1279 el menú completo no cabía junto al idioma
     y "Let's talk" ("How we work" se partía en tres líneas). */
  @media (max-width: 1279px) {
    .site-header {
      width: var(--header-width-mobile);
      height: var(--header-height-mobile);
      padding: 0 22px;
    }

    .site-nav {
      display: none;
    }

    /* v2: en móvil el header solo lleva logo y menú; idioma, tema y "Let's talk" están dentro
       del menú. */
    .lang-switch,
    .talk-button,
    .site-header__inner :global(.site-header__theme) {
      display: none;
    }

    .menu-toggle {
      position: relative;
      display: block;
      flex: none;
      width: 40px;
      height: 40px;
      margin-left: auto;
      /* Solo las tres líneas, sin círculo: el logo queda como protagonista. Toman el color del
         texto del header (negro en la píldora, blanco arriba sobre fondos oscuros). */
      background: none;
      margin-right: -8px;
    }

    .menu-toggle__lines {
      position: absolute;
      left: 11.5px;
      top: 14px;
    }

    .menu-toggle__lines i {
      display: block;
      width: 17px;
      height: 1.5px;
      margin-bottom: 3.5px;
      background: currentColor;
    }

    .menu-toggle__lines i:last-child {
      width: 13px;
      margin-bottom: 0;
    }
  }
</style>
