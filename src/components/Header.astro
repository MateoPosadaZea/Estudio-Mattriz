---
import ColorModes from './ColorModes.astro';
import LangSwitch from './LangSwitch.astro';
import { NAV } from '../data/site';
import { langOf, localize, ui } from '../i18n';

const path = Astro.url.pathname;
const lang = langOf(Astro.url);
const t = ui(lang);
---

<header class="site-header is-top" data-site-header>
  <div class="site-header__inner">
    <!-- v2: por ahora solo la M, en escritorio y en móvil (pedido de Mateo). -->
    <a class="site-header__logo" href={localize('/', lang)} aria-label="Mattriz Studio">
      <span class="site-header__word" aria-hidden="true">M<span class="site-header__rest">attriz</span></span>
    </a>

    <nav class="site-nav" aria-label={t.mainNav}>
      <ul>
        {
          NAV.map((item, i) => (
            <li>
              <a href={localize(item.href, lang)} aria-current={localize(item.href, lang) === path ? 'page' : undefined}>
                <span class="reveal">
                  <span class="reveal__text" data-text={t.nav[i]}>
                    {t.nav[i]}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Cambio de idioma: el ícono de mundo despliega los dos idiomas (en móvil el idioma está
         dentro del menú). -->
    <LangSwitch class="lang-switch" />

    <ColorModes class="site-header__theme" />

    <a class="talk-button" href="#contact-form">
      {t.talk} <span class="btn-arrow" data-dir="down" aria-hidden="true">↓</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span class="sr-only">{t.menu}</span>
      <span class="menu-toggle__lines" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>
</header>


<script>
  // Header transparente arriba del todo; al bajar, píldora blanca. El color arriba (claro u oscuro)
  // lo decide el CSS según data-page-tone de <html> (Base.astro) y el tema: no depende de medir el
  // fondo en el navegador, que en el iPhone a veces se medía antes de que cargaran los estilos.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.classList.toggle('is-top', window.scrollY < 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('pageshow', update);
  }

  // Enlace activo del menú: en el home, la sección que cruza el centro de la pantalla (o "Home"
  // arriba del todo, pero solo después de que el visitante baje: al abrir no se marca nada); en las
  // demás páginas, la página actual (aria-current).
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.site-nav a')];
  const sections = links
    .filter((a) => a.hash && a.pathname === location.pathname)
    .map((a) => ({ a, el: document.querySelector<HTMLElement>(a.hash) }))
    .filter((s): s is { a: HTMLAnchorElement; el: HTMLElement } => !!s.el);
  const page = links.find((a) => a.getAttribute('aria-current') === 'page');
  let raf = 0;
  let touched = false;
  const spy = () => {
    raf = 0;
    const mid = window.innerHeight * 0.45;
    let active = sections.find(({ el }) => {
      const r = el.getBoundingClientRect();
      return r.top < mid && r.bottom > mid;
    })?.a;
    if (!active && page && (!sections.length || (touched && window.scrollY < window.innerHeight * 0.5))) active = page;
    links.forEach((a) => a.classList.toggle('is-active', a === active));
  };
  spy();
  window.addEventListener(
    'scroll',
    () => {
      if (window.scrollY > 24) touched = true;
      raf ||= requestAnimationFrame(spy);
    },
    { passive: true },
  );
  window.addEventListener('resize', spy);
</script>

<style>
  /* Barra blanca fija, apenas redondeada (--header-radius). Vivo: top 25px, alto 70px, 70px de margen lateral. */
  .site-header {
    position: fixed;
    top: var(--header-top);
    left: 0;
    right: 0;
    z-index: 100;
    width: calc(100% - 2 * var(--header-inset));
    max-width: var(--header-max-width);
    height: var(--header-height);
    margin: 0 auto;
    padding: 0 25px;
    background: var(--color-white);
    border-radius: var(--header-radius);
    color: var(--color-black);
    animation: header-entrance 1.5s ease forwards;
    transition:
      background-color 0.4s ease,
      box-shadow 0.4s ease,
      color 0.4s ease;
  }

  /* Arriba del todo la píldora es transparente y todo se adapta al fondo de la página: blanco sobre
     fondo oscuro (un caso oscuro, o el tema oscuro en las páginas que lo siguen). Al bajar vuelve la
     píldora blanca. */
  .site-header.is-top {
    background-color: transparent;
  }

  :global(html[data-page-tone='dark']) .site-header.is-top,
  :global(html[data-page-tone='theme']:not([data-theme='light'])) .site-header.is-top {
    color: var(--color-white);
  }

  :global(html[data-page-tone='dark']) .site-header.is-top .talk-button,
  :global(html[data-page-tone='theme']:not([data-theme='light'])) .site-header.is-top .talk-button {
    color: var(--color-black);
  }

  :global(html[data-page-tone='dark']) .site-header.is-top .talk-button::before,
  :global(html[data-page-tone='theme']:not([data-theme='light'])) .site-header.is-top .talk-button::before {
    background: var(--color-white);
  }

  /* Modo rojo (ColorModes.astro): el header también va en rojo, con el botón rojo y texto blanco. */
  :global(html[data-palette='blanco-rojo']) .site-header {
    color: var(--color-brand);
  }

  :global(html[data-palette='blanco-rojo']) .site-header .talk-button::before {
    background: var(--color-brand);
  }

  @keyframes header-entrance {
    from { opacity: 0.01; }
    to { opacity: 1; }
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
  }

  /* Logotipo: la palabra "Mattriz" en Noe Display Bold (el peso de la M del logo), toda en texto
     para que la M y el resto tengan exactamente el mismo peso. Arriba del todo se ve completa; al
     bajar, "attriz" se recoge y queda la M. Toma el color del header (blanco arriba en fondos oscuros). */
  .site-header__word {
    display: inline-flex;
    font-family: var(--font-logo);
    font-size: 32px;
    font-weight: 700;
    /* Solo la altura de las mayúsculas (sin el espacio de descendentes), para que el logo quede
       centrado en vertical con el menú y los botones. */
    line-height: 0.74;
    padding-top: 0.06em;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .site-header__rest {
    display: inline-block;
    /* Solo recorta a lo ancho (para recogerse): arriba deja ver el punto de la i. */
    overflow: hidden;
    overflow: clip visible;
    padding-top: 0.2em;
    margin-top: -0.2em;
    max-width: 3.2em;
    transition:
      max-width 0.5s cubic-bezier(0.2, 1, 0.3, 1),
      opacity 0.3s ease;
  }

  .site-header:not(.is-top) .site-header__rest {
    max-width: 0;
    opacity: 0;
  }

  /* Menú centrado respecto a la píldora. */
  .site-nav {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .site-nav ul {
    display: flex;
  }

  .site-nav a {
    position: relative;
    display: block;
    white-space: nowrap;
    padding: 0 20px;
    font-size: var(--fs-menu);
    font-weight: var(--fw-menu);
    line-height: 1.3;
  }

  /* Enlace activo (la página, o la sección que se está viendo en el home): una línea fina debajo,
     del ancho del texto. */
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: -5px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.2, 1, 0.3, 1);
  }

  .site-nav a.is-active::after {
    transform: none;
  }

  :global(.lang-switch) {
    margin-left: auto;
    margin-right: 4px;
  }

  :global(.site-header__theme) {
    margin-right: 10px;
  }

  /* Botón del sistema: apenas redondeado, padding compacto y la flecha que avanza al pasar el mouse
     (global.css, .btn-arrow). */
  .talk-button {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: var(--btn-pad);
    color: var(--color-white);
    font-size: var(--fs-menu);
    font-weight: var(--fw-menu);
    line-height: 1.3;
  }

  .talk-button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--btn-radius);
  }

  /* Negro suave (#0d0d0d), el mismo del modo oscuro, no negro puro. */
  .talk-button::before {
    background: #0d0d0d;
  }

  .menu-toggle {
    display: none;
  }

  /* Header compacto por debajo de 1280px: entre 1000 y 1279 el menú completo no cabía junto al idioma
     y "Let's talk" ("How we work" se partía en tres líneas). */
  @media (max-width: 1279px) {
    /* El logo y el menú quedan alineados con el margen del texto (--pad), arriba y al bajar: la
       barra blanca se extiende un poco más allá (--header-gap-mobile del borde). */
    .site-header {
      width: calc(100% - 2 * var(--header-gap-mobile));
      height: var(--header-height-mobile);
      padding: 0 calc(var(--pad) - var(--header-gap-mobile));
      transition:
        background-color 0.4s ease,
        box-shadow 0.4s ease,
        color 0.4s ease,
        padding 0.45s cubic-bezier(0.2, 1, 0.3, 1),
        height 0.45s cubic-bezier(0.2, 1, 0.3, 1);
    }

    /* Al bajar, dentro de la barra blanca: más aire a los lados (el logo y el menú se acercan al
       centro) y una barra más baja. */
    .site-header:not(.is-top) {
      height: 58px;
      padding: 0 calc(var(--pad) + 6px);
    }

    .site-nav {
      display: none;
    }

    /* v2: en móvil el header solo lleva logo y menú; idioma, tema y "Let's talk" están dentro
       del menú. */
    .site-header__inner :global(.lang-switch),
    .talk-button,
    .site-header__inner :global(.site-header__theme) {
      display: none;
    }

    .menu-toggle {
      position: relative;
      display: block;
      flex: none;
      width: 40px;
      height: 40px;
      margin-left: auto;
      /* Solo las tres líneas, sin círculo: el logo queda como protagonista. Toman el color del
         texto del header (negro en la píldora, blanco arriba sobre fondos oscuros). */
      background: none;
      /* Las líneas terminan justo en el margen del texto (11.5px es su distancia al borde del botón). */
      margin-right: -11.5px;
    }

    .menu-toggle__lines {
      position: absolute;
      left: 11.5px;
      top: 14px;
    }

    .menu-toggle__lines i {
      display: block;
      width: 17px;
      height: 1.5px;
      margin-bottom: 3.5px;
      background: currentColor;
    }

    .menu-toggle__lines i:last-child {
      width: 13px;
      margin-bottom: 0;
    }
  }
</style>
