---
// Cursor propio: un punto que invierte los colores de lo que tiene debajo y, sobre enlaces y botones,
// una mano dibujada pequeña (grabado en puntillismo) que al hacer clic suelta unos destellos. Solo con mouse;
// en celular y tabletas no existe. En campos de texto vuelve el cursor normal.
// La mano son cuatro máscaras (public/media/cursor/hand-*.webp): relleno en el color del fondo, tinta
// en el color del texto, destellos y su halo; así se adapta a cada modo de color. Se descargan con el
// primer movimiento del mouse, no al cargar la página.
---

<div class="mz-cursor" data-cursor aria-hidden="true"></div>
<div class="mz-hand" data-cursor-hand aria-hidden="true"><i class="mz-hand__halo"></i><i class="mz-hand__rays"></i><i class="mz-hand__fill"></i><i class="mz-hand__ink"></i></div>

<script>
  const el = document.querySelector<HTMLElement>('[data-cursor]');
  const hand = document.querySelector<HTMLElement>('[data-cursor-hand]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  if (el && hand && fine.matches) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.documentElement;
    const LINK = 'a, button, [role="button"], label, summary, select, [data-cursor-grow]';
    const TEXT = 'input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]), textarea, [contenteditable="true"]';
    let x = 0;
    let y = 0;
    let cx = 0;
    let cy = 0;
    let shown = false;
    let raf = 0;

    root.classList.add('has-cursor');

    // El punto sigue al mouse con un poco de retraso (la mano va exacta); el ciclo se detiene cuando llega.
    const frame = () => {
      const k = reduced ? 1 : 0.2;
      cx += (x - cx) * k;
      cy += (y - cy) * k;
      if (Math.abs(x - cx) < 0.1 && Math.abs(y - cy) < 0.1) {
        cx = x;
        cy = y;
      }
      // translate (no transform): así el scale del clic encoge en su sitio, sin mover.
      el.style.translate = `${cx}px ${cy}px`;
      raf = cx === x && cy === y ? 0 : requestAnimationFrame(frame);
    };

    document.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        x = e.clientX;
        y = e.clientY;
        if (!shown) {
          cx = x;
          cy = y;
          shown = true;
          root.classList.add('cursor-ready');
        }
        const t = e.target instanceof Element ? e.target : null;
        const text = !!t?.closest(TEXT);
        const link = !text && !!t?.closest(LINK);
        el.classList.toggle('is-on', !text);
        el.classList.toggle('is-hidden', link);
        hand.classList.toggle('is-on', link);
        hand.style.translate = `${x}px ${y}px`;
        raf ||= requestAnimationFrame(frame);
      },
      { passive: true },
    );
    // Al salir de la ventana (o entrar a un iframe) se esconde.
    document.addEventListener('mouseout', (e) => {
      if (e.relatedTarget) return;
      el.classList.remove('is-on');
      hand.classList.remove('is-on');
    });
    document.addEventListener('pointerdown', () => {
      el.classList.add('is-down');
      hand.classList.add('is-down');
    });
    document.addEventListener('pointerup', () => {
      el.classList.remove('is-down');
      hand.classList.remove('is-down');
      if (!hand.classList.contains('is-on') || reduced) return;
      hand.classList.remove('is-burst');
      void hand.offsetWidth;
      hand.classList.add('is-burst');
    });
  }
</script>

<style is:global>
  html.has-cursor,
  html.has-cursor * {
    cursor: none !important;
  }

  html.has-cursor :is(input, textarea, [contenteditable='true']):not([type='checkbox'], [type='radio'], [type='submit'], [type='button']) {
    cursor: text !important;
  }

  .mz-cursor,
  .mz-hand {
    position: fixed;
    left: 0;
    top: 0;
    pointer-events: none;
    opacity: 0;
  }

  .mz-cursor {
    z-index: 10000;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: #fff;
    mix-blend-mode: difference;
    transition:
      opacity 0.2s ease,
      width 0.3s cubic-bezier(0.2, 1, 0.3, 1),
      height 0.3s cubic-bezier(0.2, 1, 0.3, 1),
      margin 0.3s cubic-bezier(0.2, 1, 0.3, 1),
      scale 0.2s ease;
  }

  .mz-cursor.is-on {
    opacity: 1;
  }

  .mz-cursor.is-hidden {
    width: 0;
    height: 0;
    margin: 0;
  }

  .mz-cursor.is-down {
    scale: 0.85;
  }

  /* La mano: la punta del dedo (13,2 % y 9,2 % de la imagen) queda en el puntero. */
  .mz-hand {
    --h: 48px;
    --tx: calc(var(--h) * 0.1323);
    --ty: calc(var(--h) * 0.0916);
    z-index: 10001;
    height: var(--h);
    aspect-ratio: 380 / 440;
    margin: calc(var(--ty) * -1) 0 0 calc(var(--tx) * -1);
    transform-origin: var(--tx) var(--ty);
    scale: 0.5;
    rotate: -8deg;
    transition:
      opacity 0.18s ease,
      scale 0.45s cubic-bezier(0.2, 1.4, 0.4, 1),
      rotate 0.45s cubic-bezier(0.2, 1.4, 0.4, 1);
  }

  .mz-hand.is-on {
    opacity: 1;
    scale: 1;
    rotate: 0deg;
  }

  .mz-hand.is-on.is-down {
    scale: 0.92;
    transition-duration: 0.1s;
  }

  .mz-hand i {
    position: absolute;
    inset: 0;
    -webkit-mask: var(--m) 0 0 / 100% 100% no-repeat;
    mask: var(--m) 0 0 / 100% 100% no-repeat;
  }

  .cursor-ready .mz-hand__fill {
    --m: url('/media/cursor/hand-sil.webp');
  }

  .cursor-ready .mz-hand__ink {
    --m: url('/media/cursor/hand-ink.webp');
  }

  .cursor-ready .mz-hand__rays {
    --m: url('/media/cursor/hand-rays.webp');
  }

  .cursor-ready .mz-hand__halo {
    --m: url('/media/cursor/hand-halo.webp');
  }

  .mz-hand__fill,
  .mz-hand__halo {
    background: var(--bg);
  }

  .mz-hand__ink,
  .mz-hand__rays {
    background: var(--fg);
  }

  /* Destellos: salen de la punta del dedo al soltar el clic y se desvanecen. */
  .mz-hand__rays,
  .mz-hand__halo {
    opacity: 0;
    transform-origin: var(--tx) var(--ty);
  }

  .mz-hand.is-burst :is(.mz-hand__rays, .mz-hand__halo) {
    animation: mz-hand-burst 0.55s cubic-bezier(0.2, 1, 0.3, 1);
  }

  @keyframes mz-hand-burst {
    0% {
      opacity: 0;
      scale: 0.55;
    }

    30% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      scale: 1.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mz-hand {
      transition: opacity 0.18s ease;
      scale: 1;
      rotate: 0deg;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .mz-cursor,
    .mz-hand {
      display: none;
    }
  }
</style>
