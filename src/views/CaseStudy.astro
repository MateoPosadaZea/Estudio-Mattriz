---
// v2: caso de estudio con diseño editorial (referencia: locomotive.ca).
// Contenido: el mismo del modelo del proyecto (src/components/case/extract.ts).
// Puesta en página: src/data/cases.ts.
import Base from '../layouts/Base.astro';
import CaseMedia from '../components/case/CaseMedia.astro';
import { extractCase, plain } from '../components/case/extract';
import { CASES, CASE_UI } from '../data/cases';
import { PROJECTS } from '../data/home';
import { langOf, localize, category } from '../i18n';

interface Props {
  slug: string;
  orig: any;
  model: any;
}

const { slug, orig, model } = Astro.props;
const lang = langOf(Astro.url);
const cfg = CASES[slug];
const c = extractCase(orig, model);
const t = CASE_UI[lang];
const s = c.sections;
const dark = cfg.theme === 'dark';
const bg = dark ? '#0a0a0a' : '#ffffff';

// "What we do": cada ítem es "<strong>Término</strong> descripción".
const items = [...(s['What we do']?.html ?? '').matchAll(/<li>([\s\S]*?)<\/li>/g)].map(([, li]) => {
  const m = li.match(/^\s*<strong>([\s\S]*?)<\/strong>([\s\S]*)$/);
  if (!m) return { term: '', desc: li };
  return { term: plain(m[1]).replace(/[:\s]+$/, ''), desc: m[2].replace(/^\s*:\s*/, '').trim() };
});

const number = (() => {
  const order = ['challenge', 'approach', 'whatwedo', 'impact', 'details'];
  return (key: string) => `(${String(order.indexOf(key) + 1).padStart(2, '0')})`;
})();

const idx = PROJECTS.findIndex((p) => p.href === `/project/${slug}/`);
const next = PROJECTS[(idx + 1) % PROJECTS.length];

const external = { target: '_blank', rel: 'noopener' };
const title = `${cfg.name}. ${plain(c.tagline)}`;
---

<Base
  title={model.title}
  description={model.description || c.tagline}
  background={bg}
  breadcrumb={[{ name: cfg.name, path: localize(`/project/${slug}/`, lang) }]}
>
  {
    /* Si el principal es un video, su póster es el LCP: se pide con prioridad alta. */
    c.media[cfg.hero].type === 'video' && (
      <link slot="head" rel="preload" as="image" fetchpriority="high" href={`${c.media[cfg.hero].local.dir}/${c.media[cfg.hero].local.base}-poster.webp`} />
    )
  }
  <article class:list={['case', `case--${cfg.theme}`]} style={`--accent:${cfg.accent}`} aria-label={title}>
    <header class="case-hero">
      <p class="case-eyebrow case-in">
        <span>{t.eyebrow}</span><span>{plain(s['Year']?.html ?? '')}</span>
      </p>
      <h1 class="case-title" aria-label={cfg.name}>
        {
          cfg.name.split(' ').map((w, i) => (
            <span class="case-mask" aria-hidden="true">
              <span style={`--d:${i * 90}ms`}>{w}</span>
            </span>
          ))
        }
      </h1>
      <div class="case-hero__foot">
        <p class="case-tagline case-in" style="--d:450ms">{c.tagline}</p>
        <dl class="case-facts case-in" style="--d:550ms">
          <div>
            <dt>{s['Client']?.label}</dt>
            <dd>{plain(s['Client']?.html ?? '')}</dd>
          </div>
          <div>
            <dt>{s['Industry']?.label}</dt>
            <dd>{plain(s['Industry']?.html ?? '')}</dd>
          </div>
          <div>
            <dt>{s['What we did']?.label}</dt>
            <dd>
              <ul class="case-chips">{c.categories.map((cat) => <li>{category(cat, lang)}</li>)}</ul>
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <figure class="case-hero-media" data-case-grow>
      <div class="case-hero-media__inner">
        <CaseMedia item={c.media[cfg.hero]} sizes="100vw" eager />
      </div>
    </figure>

    {
      cfg.flow.map((block) =>
        'media' in block ? (
          <div class:list={['case-gallery', `case-gallery--${block.layout}`]}>
            {block.media.map((i, n) => (
              <figure class="case-figure" data-case-reveal data-parallax={block.parallax ? '' : undefined} style={block.layout === 'pair' && n === 1 ? '--offset:8vw' : undefined}>
                <CaseMedia item={c.media[i]} sizes={block.layout === 'pair' ? '(max-width: 690px) 100vw, 50vw' : block.layout === 'inset' ? '(max-width: 690px) 100vw, 60vw' : '100vw'} />
              </figure>
            ))}
          </div>
        ) : block.section === 'challenge' ? (
          <section class="case-block">
            <p class="case-label" data-case-reveal>
              <span>{number('challenge')}</span> {s['The Challenge']?.label}
            </p>
            <div class="case-block__body">
              <div class="case-lead" data-case-reveal set:html={s['The Challenge']?.html} />
              {c.cta && (
                <a class="case-link" href={c.cta.href} {...external} data-case-reveal>
                  {c.cta.label} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </section>
        ) : block.section === 'approach' ? (
          <section class="case-block">
            <p class="case-label" data-case-reveal>
              <span>{number('approach')}</span> {s['Approach']?.label}
            </p>
            <div class="case-block__body">
              <div class="case-statement" data-case-reveal set:html={s['Approach']?.html} />
            </div>
          </section>
        ) : block.section === 'whatwedo' ? (
          <section class="case-block case-block--stack">
            <p class="case-label" data-case-reveal>
              <span>{number('whatwedo')}</span> {s['What we do']?.label}
            </p>
            <ol class="case-list">
              {items.map((it, i) => (
                <li data-case-reveal>
                  <span class="case-list__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="case-list__term">{it.term}</span>
                  <span class="case-list__desc" set:html={it.desc} />
                </li>
              ))}
            </ol>
          </section>
        ) : block.section === 'impact' ? (
          <section class="case-block">
            <p class="case-label" data-case-reveal>
              <span>{number('impact')}</span> {s['Impact']?.label}
            </p>
            <div class="case-block__body">
              {cfg.stats ? (
                <>
                  <ul class="case-stats">
                    {cfg.stats[lang].map((st) => (
                      <li data-case-reveal>
                        <span class="case-stats__value">{st.value}</span>
                        <span class="case-stats__label">{st.label}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="case-impact-list" data-case-reveal set:html={s['Impact']?.html} />
                </>
              ) : (
                <div class="case-statement" data-case-reveal set:html={s['Impact']?.html} />
              )}
            </div>
          </section>
        ) : (
          <section class="case-details">
            {['Services', 'Stack', 'Deliverables', 'Timeline'].map(
              (key) =>
                s[key] && (
                  <div class="case-details__col" data-case-reveal>
                    <h2 class="case-details__title">{s[key].label}</h2>
                    <div class="case-details__body" set:html={s[key].html} />
                  </div>
                ),
            )}
          </section>
        ),
      )
    }

    {
      c.cta && (
        <section class="case-visit">
          <a href={c.cta.href} {...external} class="case-visit__link">
            <span class="case-visit__small">{t.visit}</span>
            <span class="case-visit__big" style={`--len:${new URL(c.cta.href).hostname.replace(/^www\./, '').length}`}>
              {new URL(c.cta.href).hostname.replace(/^www\./, '')} <span aria-hidden="true">↗</span>
            </span>
          </a>
        </section>
      )
    }

    {
      next && (
        <a class="case-next" href={localize(next.href, lang)}>
          <span class="case-next__small">{t.next}</span>
          <span class="case-next__name">{next.title}</span>
          <span class="case-next__media" aria-hidden="true">
            {next.video ? (
              <video data-src={next.video} muted loop playsinline preload="none" />
            ) : (
              next.image && <img src={next.image.src} srcset={next.image.srcset} sizes="40vw" width={next.image.width} height={next.image.height} alt="" loading="lazy" decoding="async" />
            )}
          </span>
        </a>
      )
    }
  </article>
</Base>

<script>
  import '../scripts/lazy-video';
  import '../scripts/case';
</script>

<style>
  .case {
    --fg: var(--color-white);
    --muted: rgba(255, 255, 255, 0.6);
    --line: rgba(255, 255, 255, 0.2);
    --pad: clamp(20px, 5vw, 80px);
    --ease-out: cubic-bezier(0.2, 1, 0.3, 1);
    color: var(--fg);
    background: var(--page-bg);
    overflow-x: clip;
  }

  .case--light {
    --fg: var(--color-ink);
    --muted: rgba(10, 10, 10, 0.6);
    --line: rgba(10, 10, 10, 0.15);
  }

  /* ---------- Hero ---------- */

  .case-hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Deja asomar el video principal por debajo. */
    min-height: 88vh;
    min-height: 88svh;
    padding: calc(var(--header-top) + var(--header-height) + 40px) var(--pad) clamp(32px, 5vw, 64px);
  }

  .case-eyebrow {
    display: flex;
    gap: 1.5em;
    margin-bottom: 2vw;
    font-size: 15px;
    color: var(--muted);
  }

  .case-eyebrow span:first-child::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 1px;
  }

  .case--dark .case-eyebrow span:first-child::before {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35);
  }

  .case-title {
    margin: 0 0 0 -0.05em;
    font-family: var(--font-display);
    font-size: clamp(76px, 17vw, 300px);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .case-mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-right: 0.18em;
    vertical-align: top;
  }

  .case-mask:last-child {
    margin-right: 0;
  }

  .case-mask > span {
    display: inline-block;
  }

  html.js .case-mask > span {
    transform: translateY(110%);
    animation: case-rise 1.2s var(--ease-out) forwards;
    animation-delay: calc(0.15s + var(--d, 0ms));
  }

  /* Resto del hero: entra con CSS (no espera al JS, así no retrasa el LCP). */
  html.js .case-in {
    animation: case-in 1s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes case-in {
    from {
      opacity: 0.01;
      transform: translateY(30px);
    }
  }

  @keyframes case-rise {
    to {
      transform: none;
    }
  }

  .case-hero__foot {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: clamp(32px, 4vw, 64px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 1000px) {
    .case-hero__foot {
      grid-template-columns: 5fr 7fr;
      gap: 6vw;
    }
  }

  .case-tagline {
    max-width: 22em;
    font-size: clamp(22px, 2.2vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .case-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 32px;
    font-size: 15px;
    line-height: 1.5;
  }

  @media (min-width: 1000px) {
    .case-facts {
      grid-template-columns: 1fr 1fr 1.4fr;
    }
  }

  .case-facts div:last-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 1000px) {
    .case-facts div:last-child {
      grid-column: auto;
    }
  }

  .case-facts dd {
    margin: 0;
  }

  .case-facts dt {
    margin-bottom: 6px;
    color: var(--muted);
  }

  .case-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .case-chips li {
    padding: 3px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  /* ---------- Media principal: crece hasta el ancho completo al hacer scroll ---------- */

  .case-hero-media {
    margin: 0;
    padding: 0 var(--pad);
  }

  .case-hero-media__inner {
    overflow: hidden;
    border-radius: calc(16px * (1 - var(--grow, 0)));
    transform: scale(calc(1 + var(--grow, 0) * var(--grow-max, 0)));
    transform-origin: 50% 0;
    will-change: transform;
  }

  /* ---------- Bloques de texto ---------- */

  .case-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: clamp(80px, 12vw, 200px) var(--pad);
  }

  @media (min-width: 1000px) {
    .case-block {
      grid-template-columns: 4fr 8fr;
      gap: 4vw;
    }

    .case-block--stack {
      grid-template-columns: 1fr;
    }
  }

  .case-label {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  .case-label span {
    margin-right: 0.6em;
    color: var(--fg);
  }

  .case-block__body {
    max-width: 58rem;
  }

  .case-lead {
    font-size: clamp(20px, 1.9vw, 30px);
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .case-lead :global(p + p),
  .case-statement :global(p + p) {
    margin-top: 1em;
  }

  .case-lead :global(strong) {
    font-family: var(--font-sans-book);
    font-weight: normal;
  }

  .case-statement {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.6vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .case-link {
    display: inline-flex;
    gap: 0.4em;
    margin-top: 40px;
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    font-size: 17px;
  }

  .case-link span {
    transition: transform 0.4s var(--ease-out);
  }

  .case-link:hover span {
    transform: translate(3px, -3px);
  }

  /* Lista numerada "What we do". */
  .case-list {
    border-top: 1px solid var(--line);
  }

  .case-list li {
    display: grid;
    grid-template-columns: 3em 1fr;
    gap: 6px 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16px;
    line-height: 1.5;
  }

  @media (min-width: 1000px) {
    .case-list li {
      grid-template-columns: 4fr 3fr 5fr;
      gap: 4vw;
      align-items: baseline;
      padding: 28px 0;
    }
  }

  .case-list__n {
    color: var(--muted);
    font-size: 15px;
  }

  @media (min-width: 1000px) {
    .case-list__n {
      text-align: left;
    }
  }

  .case-list__term {
    font-family: var(--font-display);
    font-size: clamp(22px, 2vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .case-list__desc {
    grid-column: 2;
    color: var(--muted);
  }

  @media (min-width: 1000px) {
    .case-list__desc {
      grid-column: auto;
    }
  }

  .case-list__desc:empty {
    display: none;
  }

  /* Cifras destacadas. */
  .case-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-bottom: 48px;
  }

  @media (min-width: 690px) {
    .case-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .case-stats li {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .case-stats__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(44px, 3.8vw, 68px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .case-stats__label {
    display: block;
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--muted);
  }

  .case-impact-list :global(ul),
  .case-details__body :global(ul) {
    display: grid;
    gap: 6px;
  }

  .case-impact-list {
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }

  .case-impact-list :global(li)::before,
  .case-details__body :global(li)::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin: 0 10px 2px 0;
    border-radius: 50%;
    background: currentColor;
  }

  /* ---------- Galerías ---------- */

  .case-gallery {
    display: grid;
    gap: clamp(12px, 1.5vw, 24px);
    padding: 0 var(--pad);
    margin-bottom: clamp(12px, 1.5vw, 24px);
  }

  .case-gallery--full {
    padding: 0;
  }

  .case-gallery--pair {
    align-items: start;
  }

  @media (min-width: 690px) {
    .case-gallery--pair {
      grid-template-columns: 1fr 1fr;
    }

    /* La segunda pieza del par baja un poco: ritmo escalonado. */
    .case-gallery--pair .case-figure:nth-child(2) {
      margin-top: var(--offset, 0);
    }
  }

  .case-gallery--inset {
    padding: clamp(40px, 8vw, 120px) var(--pad);
    justify-items: center;
  }

  .case-gallery--inset .case-figure {
    width: min(100%, 720px);
  }

  .case-figure {
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
  }

  .case-gallery--full .case-figure {
    border-radius: 0;
  }

  /* ---------- Detalles ---------- */

  .case-details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding: clamp(80px, 12vw, 180px) var(--pad);
    font-size: 16px;
    line-height: 1.5;
  }

  @media (min-width: 690px) {
    .case-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .case-details {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 4vw;
    }
  }

  .case-details__col {
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .case-details__title {
    margin-bottom: 16px;
    font-size: 15px;
    font-weight: inherit;
    color: var(--muted);
  }

  /* ---------- Sitio en vivo ---------- */

  .case-visit {
    padding: 0 var(--pad) clamp(80px, 10vw, 160px);
  }

  .case-visit__link {
    display: block;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .case-visit__small {
    display: block;
    margin-bottom: 12px;
    font-size: 15px;
    color: var(--muted);
  }

  .case-visit__big {
    display: inline-block;
    font-family: var(--font-display);
    /* Tamaño según el largo del dominio para que quepa en una línea. */
    font-size: clamp(28px, min(8vw, calc(170vw / var(--len, 12))), 140px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }

  .case-visit__big span {
    display: inline-block;
    transition: transform 0.6s var(--ease-out);
  }

  .case-visit__link:hover .case-visit__big {
    background-size: 100% 2px;
  }

  .case-visit__link:hover .case-visit__big span {
    transform: translate(0.08em, -0.08em);
  }

  /* ---------- Siguiente proyecto ---------- */

  .case-next {
    position: relative;
    display: block;
    overflow: hidden;
    padding: clamp(60px, 10vw, 160px) var(--pad);
    background: var(--accent);
    color: var(--color-white);
  }

  .case--light .case-next {
    color: var(--color-ink);
  }

  .case-next__small {
    position: relative;
    z-index: 1;
    display: block;
    margin-bottom: 16px;
    font-size: 15px;
  }

  .case-next__name {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 12em;
    font-family: var(--font-display);
    font-size: clamp(52px, 10vw, 180px);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .case-next__media {
    position: absolute;
    right: var(--pad);
    top: 50%;
    width: min(36vw, 520px);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    opacity: 0;
    transform: translateY(-40%) scale(0.9) rotate(-3deg);
    transition:
      opacity 0.5s,
      transform 0.8s var(--ease-out);
  }

  .case-next__media :global(video),
  .case-next__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: hover) and (min-width: 1000px) {
    .case-next:hover .case-next__media {
      opacity: 1;
      transform: translateY(-50%) scale(1) rotate(0);
    }
  }

  /* ---------- Entradas al hacer scroll (src/scripts/case.ts) ---------- */

  html.js [data-case-reveal] {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.9s var(--ease-out),
      transform 1.1s var(--ease-out);
  }

  html.js [data-case-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  html.js .case-figure[data-case-reveal] {
    transform: translateY(80px);
  }

  /* Parallax: la imagen se mueve dentro de su marco (src/scripts/case.ts pone --py). */
  html.js .case-figure[data-parallax] > :global(*) {
    transform: translateY(var(--py, 0px)) scale(1.1);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    html.js [data-case-reveal],
    html.js .case-mask > span,
    html.js .case-in,
    html.js .case-figure[data-parallax] > :global(*),
