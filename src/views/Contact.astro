---
// v2: contacto en negro. Solo el formulario escrito como frase (el mismo del footer, que en esta
// página no se repite), con aire alrededor: los testimonios viven en el home y en cada caso.
// Envía a /api/contact (Worker con Resend + Turnstile + honeypot).
import Base from '../layouts/Base.astro';
import FooterForm from '../components/FooterForm.astro';
import { contact } from '../data/contact';
import { langOf, localize, ui } from '../i18n';

const lang = langOf(Astro.url);
const { CONTACT } = contact(lang);
const t = ui(lang);

---

<Base
  breadcrumb={[{ name: CONTACT.breadcrumb, path: localize('/contact/', lang) }]}
  title={CONTACT.metaTitle}
  description={CONTACT.metaDescription}
  background="var(--bg)"
  footerForm={false}
>
  <div class="home ct">
    <section class="ct__form" aria-labelledby="ct-title">
      <p class="ct__status case-in" id="contact-form">
        {t.accepting}
      </p>
      <h1 class="ct__title" id="ct-title">
        {
          CONTACT.title.split(' ').map((w, i) => (
            <span class="case-mask" aria-hidden="true">
              <span style={`--d:${i * 70}ms`}>{w}</span>
            </span>
          ))
        }
        <span class="sr-only">{CONTACT.title}</span>
      </h1>
      <!-- Sin animación de entrada: es el contenido principal (LCP) y debe verse al instante. -->
      <FooterForm />
    </section>
  </div>
</Base>

<script>
  import '../scripts/case';
  import '../scripts/lazy-video';
</script>

<style>
  .ct {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    /* Todo el bloque (título, frase y Send) cabe en la pantalla al llegar: el aire de arriba y abajo y
       los tamaños de letra se ajustan también al alto de la ventana, no solo al ancho. */
    padding: calc(var(--header-top) + var(--header-height) + clamp(20px, 6vh, 112px)) var(--pad) clamp(28px, 7vh, 120px);
  }

  /* La frase del formulario, un poco más contenida en pantallas bajas. */
  .ct :global(.ff__sentence) {
    font-size: clamp(20px, min(3.4vw, 5.6vh), 54px);
  }

  .ct__form {
    max-width: 1180px;
  }

  .ct__status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(12px, 2.4vh, 32px);
    font-size: 15px;
    color: var(--muted);
  }

  .ct__title {
    margin-bottom: clamp(20px, 4.5vh, 56px);
    font-family: var(--font-display);
    font-size: clamp(40px, min(6.4vw, 10vh), 112px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

</style>
